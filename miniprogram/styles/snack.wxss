page { background: #F8F6F1; color: #26352E; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; }
.snack-page { min-height: 100vh; padding: 0 32rpx calc(180rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.page-lead { padding: 40rpx 4rpx 30rpx; }
.small-kicker { font-size: 15rpx; color: #34765B; font-weight: 700; letter-spacing: 2rpx; margin-bottom: 14rpx; }
.page-title { font-size: 46rpx; font-weight: 800; line-height: 1.24; letter-spacing: -1rpx; }
.title-period { color: #ED6A38; }
.page-sub { font-size: 22rpx; color: #66736C; margin-top: 12rpx; line-height: 1.5; }
.primary-action { display: flex; align-items: center; justify-content: center; min-height: 88rpx; padding: 0 28rpx; border-radius: 22rpx; color: #FFFFFF; background: #34765B; font-size: 25rpx; font-weight: 700; }
.empty-art { width: 176rpx; height: 176rpx; background: #EDF3E9; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 32rpx; }
.empty-pack { height: 92rpx; width: 76rpx; background: #34765B; transform: rotate(-10deg); border-radius: 10rpx; color: #fff; font-size: 17rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.empty-heading { font-size: 30rpx; font-weight: 800; margin-bottom: 12rpx; }
.empty-copy { font-size: 22rpx; color: #69746B; line-height: 1.7; max-width: 520rpx; margin: 0 auto; }
.empty-action { margin: 36rpx auto 0; min-width: 260rpx; display: inline-flex; }
.tone-peach { background: #F7DFC6; }.tone-cocoa { background: #E9D3BE; }.tone-butter { background: #F5EDC6; }.tone-sage { background: #DDE9D8; }.tone-rose { background: #F3DFD5; }.tone-mango { background: #F8DFB5; }.tone-lemon { background: #EBEAC8; }.tone-oat { background: #E6E0D3; }
