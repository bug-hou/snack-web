page { background: #F8F6F1; color: #26352E; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; }
button { padding: 0; margin: 0; font: inherit; line-height: normal; text-align: left; color: inherit; background: transparent; border: 0; border-radius: 0; overflow: visible; }
button::after { border: none; }

.forum-page { padding: 24rpx 32rpx calc(180rpx + env(safe-area-inset-bottom)); }
.forum-head { display: flex; align-items: center; justify-content: space-between; }
.forum-brand { display: flex; align-items: center; flex: 1; min-width: 0; }
.brand-mark { width: 68rpx; height: 68rpx; border-radius: 22rpx 22rpx 22rpx 6rpx; background: #34765B; color: #fff; font-size: 32rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-right: 16rpx; flex-shrink: 0; }
.brand-copy { flex: 1; min-width: 0; }
.brand-name { font-size: 34rpx; font-weight: 800; letter-spacing: 1rpx; }
.brand-kicker { font-size: 19rpx; color: #66736C; margin-top: 4rpx; }

.board-scroll { white-space: nowrap; margin: 26rpx -32rpx 0; padding: 0 32rpx; }
.board-chip { display: inline-block; min-height: 70rpx; line-height: 70rpx; padding: 0 28rpx; margin-right: 14rpx; border-radius: 35rpx; background: #ECEFE6; color: #5C685D; font-size: 23rpx; }
.board-chip.selected { background: #34765B; color: #fff; font-weight: 700; }

.forum-notice { margin: 22rpx 0 6rpx; padding: 16rpx 20rpx; border-radius: 18rpx; background: #F1EFE5; color: #6C766B; font-size: 19rpx; line-height: 1.55; }

.forum-message { padding: 56rpx 0; text-align: center; color: #69746B; font-size: 23rpx; }
.forum-message.retry:active { color: #34765B; }
.forum-empty { margin-top: 30rpx; padding: 60rpx 34rpx; text-align: center; background: #fff; border: 1rpx solid #E4EAE0; border-radius: 26rpx; }
.empty-art { width: 96rpx; height: 96rpx; margin: 0 auto 18rpx; border-radius: 30rpx; background: #EDF3E9; display: flex; align-items: center; justify-content: center; }
.empty-art image { width: 44rpx; height: 44rpx; }
.empty-title { font-size: 28rpx; font-weight: 800; }
.empty-copy { font-size: 22rpx; color: #69746B; margin-top: 10rpx; line-height: 1.6; }
.primary-action { display: inline-flex; align-items: center; justify-content: center; margin-top: 26rpx; min-height: 80rpx; padding: 0 40rpx; border-radius: 22rpx; background: #34765B; color: #fff; font-size: 24rpx; font-weight: 700; }

.post-card { background: #fff; border: 1rpx solid #E4EAE0; border-radius: 26rpx; padding: 24rpx; margin-top: 20rpx; }
.post-pressed { background: #F4F6F1; }
.post-top { display: flex; align-items: center; }
.post-board { padding: 4rpx 14rpx; border-radius: 10rpx; background: #EDF3E9; color: #34765B; font-size: 17rpx; font-weight: 700; }
.post-pin { margin-left: 10rpx; padding: 4rpx 14rpx; border-radius: 10rpx; background: #FBE6D6; color: #8A5A33; font-size: 17rpx; font-weight: 700; }
.post-title { font-size: 29rpx; font-weight: 800; line-height: 1.45; margin-top: 14rpx; }
.post-excerpt { font-size: 21rpx; color: #6B756C; line-height: 1.6; margin-top: 10rpx; max-height: 68rpx; overflow: hidden; }
.post-thumbs { display: flex; margin-top: 14rpx; }
.post-thumb { width: 150rpx; height: 150rpx; margin-right: 10rpx; border-radius: 16rpx; background: #EDEFE6; flex-shrink: 0; }
.post-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.post-author { display: flex; align-items: center; min-width: 0; font-size: 20rpx; color: #5C685D; }
.post-avatar { width: 40rpx; height: 40rpx; margin-right: 10rpx; border-radius: 50%; background: #DDE9D8; color: #34765B; font-size: 17rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.post-meta { display: flex; align-items: center; font-size: 18rpx; color: #949E94; flex-shrink: 0; }
.meta-dot { margin: 0 8rpx; }

.publish-button { position: fixed; left: 32rpx; right: 32rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: center; min-height: 92rpx; border-radius: 24rpx; background: #34765B; color: #fff; font-size: 26rpx; font-weight: 700; }
.publish-button image { width: 28rpx; height: 28rpx; margin-right: 10rpx; }
