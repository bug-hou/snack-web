<view class="detail-page">
  <view wx:if="{{loading}}" class="detail-message">正在加载物品…</view>
  <view wx:elif="{{error}}" class="detail-message">{{error}}</view>
  <block wx:elif="{{item}}">
    <swiper wx:if="{{item.images.length}}" class="gallery" indicator-dots="{{item.images.length > 1}}" circular="{{false}}">
      <swiper-item wx:for="{{item.images}}" wx:key="*this"><image class="gallery-image" src="{{item}}" mode="aspectFill"/></swiper-item>
    </swiper>
    <view wx:else class="gallery-empty">暂无图片</view>

    <view class="info-card">
      <view class="info-title">{{item.title}}</view>
      <view class="info-price">{{item.mode === 'sale' ? '¥' + item.price : '免费分享'}}</view>
      <view class="info-tags"><text class="tag">{{item.conditionText}}</text><text class="tag mode">{{item.modeText}}</text><text wx:if="{{item.isMine}}" class="tag mine">{{item.statusText}}</text></view>
      <view class="info-desc">{{item.description}}</view>
    </view>

    <view class="info-card">
      <view class="row"><text class="row-label">交接地点</text><text class="row-value">{{item.meetup}}</text></view>
      <view class="tip">建议在白天的小区公共区域当面交接，并当场检查物品。</view>
    </view>

    <view wx:if="{{item.isMine}}" class="owner-actions">
      <button class="ghost-btn" bindtap="markOff">下架</button>
      <button class="ghost-btn" bindtap="markTaken">已转出</button>
      <button wx:if="{{item.status !== 'pending' && item.status !== 'approved'}}" class="ghost-btn" bindtap="relist">重新上架</button>
    </view>

    <button class="share-btn" open-type="share">分享给邻居　→</button>
    <view class="foot-note">分享只包含物品公开信息，不会展示联系方式。</view>
  </block>
</view>
