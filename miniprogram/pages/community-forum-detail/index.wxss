page { background: #F8F6F1; color: #26352E; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; }
button { padding: 0; margin: 0; font: inherit; line-height: normal; color: inherit; background: transparent; border: 0; border-radius: 0; overflow: visible; }
button::after { border: none; }

.detail-page { padding: 24rpx 32rpx calc(160rpx + env(safe-area-inset-bottom)); }
.detail-message { padding: 80rpx 0; text-align: center; color: #69746B; font-size: 23rpx; }

.post-main { background: #fff; border: 1rpx solid #E4EAE0; border-radius: 26rpx; padding: 28rpx; }
.post-board { display: inline-block; padding: 5rpx 16rpx; border-radius: 10rpx; background: #EDF3E9; color: #34765B; font-size: 17rpx; font-weight: 700; }
.post-title { font-size: 36rpx; font-weight: 800; line-height: 1.4; margin-top: 16rpx; }
.author-row { display: flex; align-items: center; margin-top: 22rpx; }
.post-avatar { width: 56rpx; height: 56rpx; border-radius: 50%; background: #DDE9D8; color: #34765B; font-size: 20rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-right: 16rpx; flex-shrink: 0; }
.author-copy { flex: 1; min-width: 0; }
.author-name { font-size: 23rpx; font-weight: 700; }
.mine-tag { margin-left: 12rpx; padding: 3rpx 12rpx; border-radius: 8rpx; background: #ECEEE5; color: #5C685D; font-size: 17rpx; font-weight: 400; }
.author-time { font-size: 18rpx; color: #949E94; margin-top: 4rpx; }
.post-content { font-size: 26rpx; line-height: 1.85; margin-top: 24rpx; white-space: pre-wrap; word-break: break-all; }
.post-images { margin-top: 20rpx; }
.post-image { width: 100%; border-radius: 20rpx; margin-bottom: 14rpx; display: block; }

.action-row { display: flex; align-items: center; margin: 26rpx 0 34rpx; }
.like-btn { min-height: 76rpx; padding: 0 34rpx; border-radius: 38rpx; background: #fff; border: 1rpx solid #E4EAE0; font-size: 23rpx; font-weight: 700; color: #4C5B50; display: flex; align-items: center; }
.like-btn.liked { background: #E6EEE1; border-color: #CBDCC4; color: #34765B; }
.share-btn { flex: 1; margin-left: 16rpx; min-height: 76rpx; border-radius: 38rpx; background: #EDF3E9; color: #34765B; font-size: 23rpx; font-weight: 700; text-align: center; line-height: 76rpx; }
.delete-btn { margin-left: 16rpx; min-height: 76rpx; padding: 0 28rpx; border-radius: 38rpx; background: #FBEAE3; color: #A2461F; font-size: 23rpx; display: flex; align-items: center; }

.comment-head { font-size: 27rpx; font-weight: 800; margin-bottom: 18rpx; }
.comment-head text { font-size: 20rpx; color: #949E94; margin-left: 8rpx; font-weight: 400; }
.comment-empty { padding: 48rpx 30rpx; text-align: center; background: #fff; border: 1rpx solid #E4EAE0; border-radius: 24rpx; }
.empty-title { font-size: 25rpx; font-weight: 800; }
.empty-copy { font-size: 21rpx; color: #69746B; margin-top: 10rpx; }

.comment-card { background: #fff; border: 1rpx solid #E4EAE0; border-radius: 24rpx; padding: 22rpx; margin-top: 16rpx; }
.comment-top { display: flex; align-items: center; }
.comment-avatar { width: 46rpx; height: 46rpx; border-radius: 50%; background: #DDE9D8; color: #34765B; font-size: 17rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-right: 14rpx; flex-shrink: 0; }
.comment-copy { flex: 1; min-width: 0; }
.comment-author { font-size: 22rpx; font-weight: 700; }
.comment-time { font-size: 17rpx; color: #949E94; margin-top: 4rpx; }
.comment-del { font-size: 19rpx; color: #A2461F; padding: 10rpx 4rpx; flex-shrink: 0; }
.comment-body { font-size: 24rpx; line-height: 1.75; margin-top: 14rpx; white-space: pre-wrap; word-break: break-all; }

.detail-foot { margin-top: 40rpx; font-size: 19rpx; color: #949E94; line-height: 1.7; }

.comment-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #EDEFE6; }
.comment-input { flex: 1; min-height: 80rpx; padding: 0 24rpx; background: #F5F7F1; border-radius: 40rpx; font-size: 24rpx; }
.comment-placeholder { color: #A3AC9F; }
.comment-send { margin-left: 16rpx; min-height: 80rpx; padding: 0 34rpx; border-radius: 40rpx; background: #34765B; color: #fff; font-size: 24rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.comment-send.disabled { background: #A9B4A9; }
