@import "../../styles/snack.wxss";
.profile-hero { border-radius: 27rpx; min-height: 180rpx; background: #314035; display: flex; gap: 28rpx; align-items: center; padding: 28rpx; color: white; }.profile-stamp { width: 110rpx; height: 110rpx; border-radius: 22rpx; background: #E6B888; color: #624D3A; font-size: 18rpx; font-weight: 800; text-align: center; line-height: 1.4; display: flex; align-items: center; justify-content: center; transform: rotate(-7deg); }.profile-hero-title { font-size: 33rpx; font-weight: 800; }.profile-hero-sub { font-size: 20rpx; color: #CAD5CA; margin-top: 6rpx; }.profile-section { background: #fff; margin-top: 26rpx; border-radius: 24rpx; padding: 8rpx 26rpx; }.profile-section-heading { font-size: 28rpx; font-weight: 800; padding: 24rpx 0 6rpx; }.profile-row { min-height: 118rpx; border-bottom: 1rpx solid #F2EDE6; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }.profile-row:last-child { border-bottom: 0; }.profile-row-title { font-size: 24rpx; font-weight: 700; }.profile-row-sub { font-size: 19rpx; color: #9B958D; margin-top: 5rpx; }.profile-row > text { color: #B2634B; font-size: 20rpx; white-space: nowrap; }.compliance-note { margin-top: 25rpx; border-radius: 23rpx; background: #F4ECE1; padding: 25rpx; color: #847260; font-size: 22rpx; line-height: 1.7; }.compliance-title { font-size: 25rpx; font-weight: 800; color: #634C38; margin-bottom: 9rpx; }.profile-link { text-align: center; border-radius: 22rpx; background: #2E382F; color: white; padding: 26rpx; margin-top: 28rpx; font-size: 24rpx; font-weight: 700; }.profile-footer { text-align: center; color: #B4AEA4; font-size: 18rpx; letter-spacing: 2rpx; margin-top: 45rpx; }.profile-hero { background: #FF7451; }
.profile-stamp { background: #FFE690; color: #8E453A; }
.profile-stamp { font-size: 17rpx; word-break: break-word; }
.profile-link { background: #FF654E; }
.compliance-note { background: #FFF1D7; color: #8B6344; }
.profile-row > text { color: #ED6751; }
.owner-id { padding: 16rpx 0 26rpx; color: #766B67; font-size: 20rpx; word-break: break-all; }
.owner-id view { margin-top: 14rpx; color: #F16D50; font-weight: 700; }
