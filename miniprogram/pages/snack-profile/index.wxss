@import "../../styles/snack.wxss";
.profile-page { padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }
.profile-hero { border-radius: 26rpx; min-height: 180rpx; background: #34765B; display: flex; gap: 28rpx; align-items: center; padding: 28rpx; color: #fff; }
.profile-stamp { width: 110rpx; height: 110rpx; border-radius: 22rpx; background: #F6D781; color: #26352E; font-size: 29rpx; font-weight: 800; letter-spacing: 2rpx; text-align: center; display: flex; align-items: center; justify-content: center; transform: rotate(-7deg); }
.profile-hero-title { font-size: 33rpx; font-weight: 800; }
.profile-hero-sub { font-size: 22rpx; color: #E5EEE2; margin-top: 6rpx; }
.profile-section { background: #fff; border: 1rpx solid #E4EAE0; margin-top: 22rpx; border-radius: 26rpx; padding: 8rpx 26rpx; }
.profile-section-heading { font-size: 26rpx; font-weight: 800; padding: 24rpx 0 6rpx; }
.profile-row { min-height: 118rpx; border-bottom: 1rpx solid #EEF1EA; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.profile-row:last-child { border-bottom: 0; }
.profile-row-title { font-size: 26rpx; font-weight: 700; }
.profile-row-sub { font-size: 20rpx; color: #8A938A; margin-top: 6rpx; }
.profile-row > text { color: #34765B; font-size: 21rpx; font-weight: 700; white-space: nowrap; }
.compliance-note { margin-top: 24rpx; border-radius: 22rpx; background: #E6EEE1; padding: 24rpx; color: #596D54; font-size: 22rpx; line-height: 1.7; }
.compliance-title { font-size: 25rpx; font-weight: 800; color: #26352E; margin-bottom: 8rpx; }
.profile-link { text-align: center; border-radius: 22rpx; background: #34765B; color: #fff; padding: 26rpx; margin-top: 24rpx; font-size: 25rpx; font-weight: 700; }
.profile-footer { text-align: center; color: #8A938A; font-size: 19rpx; letter-spacing: 2rpx; margin-top: 40rpx; }
.owner-id { padding: 16rpx 0 26rpx; color: #6B756C; font-size: 20rpx; word-break: break-all; }
.owner-id view { margin-top: 14rpx; color: #34765B; font-weight: 700; }
