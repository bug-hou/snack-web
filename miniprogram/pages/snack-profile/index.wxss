@import "../../styles/snack.wxss";
.profile-hero { border-radius: 27rpx; min-height: 180rpx; background: #1A1A1A; display: flex; gap: 28rpx; align-items: center; padding: 28rpx; color: white; }.profile-stamp { width: 110rpx; height: 110rpx; border-radius: 22rpx; background: #FF6A00; color: #4E4E4E; font-size: 18rpx; font-weight: 800; text-align: center; line-height: 1.4; display: flex; align-items: center; justify-content: center; transform: rotate(-7deg); }.profile-hero-title { font-size: 33rpx; font-weight: 800; }.profile-hero-sub { font-size: 20rpx; color: #D0D0D0; margin-top: 6rpx; }.profile-section { background: #fff; margin-top: 26rpx; border-radius: 24rpx; padding: 8rpx 26rpx; }.profile-section-heading { font-size: 28rpx; font-weight: 800; padding: 24rpx 0 6rpx; }.profile-row { min-height: 118rpx; border-bottom: 1rpx solid #EEEEEE; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }.profile-row:last-child { border-bottom: 0; }.profile-row-title { font-size: 24rpx; font-weight: 700; }.profile-row-sub { font-size: 19rpx; color: #949494; margin-top: 5rpx; }.profile-row > text { color: #C81623; font-size: 20rpx; white-space: nowrap; }.compliance-note { margin-top: 25rpx; border-radius: 23rpx; background: #EEEEEE; padding: 25rpx; color: #727272; font-size: 22rpx; line-height: 1.7; }.compliance-title { font-size: 25rpx; font-weight: 800; color: #4E4E4E; margin-bottom: 9rpx; }.profile-link { text-align: center; border-radius: 22rpx; background: #1A1A1A; color: white; padding: 26rpx; margin-top: 28rpx; font-size: 24rpx; font-weight: 700; }.profile-footer { text-align: center; color: #ACACAC; font-size: 18rpx; letter-spacing: 2rpx; margin-top: 45rpx; }.profile-hero { background: #E1251B; }
.profile-stamp { background: #FFEFED; color: #C81623; }
.profile-stamp { font-size: 17rpx; word-break: break-word; }
