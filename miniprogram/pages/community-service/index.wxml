<view class="service-page theme-{{service.id}}">
  <view class="service-tabs">
    <button wx:for="{{services}}" wx:key="id" class="service-tab {{service.id === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectService">{{item.shortTitle}}</button>
  </view>
  <view class="service-hero">
    <view class="hero-copy"><text class="hero-label">{{service.label}}</text><view class="hero-title">{{service.title}}</view><view class="hero-subtitle">{{service.subtitle}}</view></view>
    <view class="hero-icon"><image src="/images/community/{{service.icon}}.svg" mode="aspectFit"/></view>
  </view>
  <view class="hero-description">{{service.description}}</view>
  <view class="preparation-card"><view class="preparation-line"><view class="status-dot"></view><text>服务筹备中</text></view><view class="preparation-copy">{{service.id === 'secondhand' ? '尚未开放物品浏览与发布，以下为分享流程说明。' : '暂未开放需求登记，服务范围、费用与时间确认后再开放。'}}</view></view>
  <view class="section-heading"><text>{{service.id === 'secondhand' ? '好物分享，只需三步' : '服务将这样进行'}}</text><text class="section-caption">流程说明</text></view>
  <view class="steps-card"><view wx:for="{{service.steps}}" wx:key="title" class="step-row"><view class="step-number">0{{index + 1}}</view><view class="step-copy"><view class="step-title">{{item.title}}</view><view class="step-description">{{item.description}}</view></view></view></view>
  <view class="section-heading"><text>{{service.id === 'secondhand' ? '友好的邻里，安心的分享' : '先说清楚，再放心使用'}}</text></view>
  <view class="rules-card"><view wx:for="{{service.rules}}" wx:key="title" class="rule-row"><view class="rule-title">{{item.title}}</view><view class="rule-description">{{item.description}}</view></view></view>
  <view wx:if="{{service.id === 'purchase'}}" class="existing-shop"><view class="existing-title">现在需要买点东西？</view><view class="existing-description">原口袋便利铺商品信息可继续查看，库存与营业状态以商品区为准。</view><button class="existing-link" bindtap="goCatalog">浏览便利铺商品 <text>→</text></button></view>
  <view class="page-footnote">保利爱尚里 · 让邻里生活近一点</view>
  <view class="service-footer"><button class="footer-secondary" bindtap="goHome">返回社区</button><button wx:if="{{service.id === 'secondhand'}}" class="footer-primary" bindtap="showSharingGuide">查看发布须知</button><button wx:elif="{{service.id === 'purchase'}}" class="footer-primary" bindtap="goCatalog">先看便利铺商品</button><button wx:else class="footer-primary" bindtap="goAddress">管理收货地址</button></view>
</view>
