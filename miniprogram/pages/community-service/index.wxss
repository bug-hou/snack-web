page { background: #F8F6F1; color: #26352E; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; }
button { padding: 0; margin: 0; font: inherit; line-height: inherit; text-align: left; background: transparent; color: inherit; border-radius: 0; }
button::after { border: none; }
.service-page { padding: 24rpx 32rpx calc(200rpx + env(safe-area-inset-bottom)); min-height: 100vh; box-sizing: border-box; }
.service-tabs { display: flex; gap: 8rpx; background: #ECEFE6; padding: 7rpx; border-radius: 22rpx; margin-bottom: 28rpx; }
.service-tab { flex: 1; min-width: 0; min-height: 78rpx; display: flex; align-items: center; justify-content: center; font-size: 22rpx; border-radius: 17rpx; color: #64705F; white-space: nowrap; }
.service-tab.active { background: #fff; color: #26352E; font-weight: 700; }
.service-hero { position: relative; overflow: hidden; min-height: 212rpx; border-radius: 28rpx; padding: 30rpx; display: flex; align-items: center; background: #FBE6D6; box-sizing: border-box; }
.theme-purchase .service-hero { background: #F3EDD9; }
.theme-secondhand .service-hero { background: #E6EEE1; }
.hero-copy { position: relative; z-index: 1; flex: 1; min-width: 0; }
.hero-label { color: #674B35; background: rgba(255,255,255,.7); border-radius: 9rpx; font-size: 19rpx; padding: 5rpx 12rpx; }
.hero-title { font-size: 38rpx; font-weight: 800; margin-top: 16rpx; }
.theme-purchase .hero-title { font-size: 34rpx; }
.hero-subtitle { font-size: 23rpx; color: #5D6A5C; margin-top: 8rpx; }
.hero-icon { width: 116rpx; height: 116rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 30rpx; background: rgba(255,255,255,.7); transform: rotate(9deg); margin-left: 14rpx; }
.hero-icon image { width: 78rpx; height: 78rpx; transform: rotate(-17deg); }
.hero-description { font-size: 25rpx; color: #637060; line-height: 1.7; margin: 24rpx 4rpx; }
.preparation-card { border-radius: 22rpx; background: #FFF6E8; padding: 22rpx 24rpx; border: 1rpx solid #EEDDC1; }
.preparation-line { display: flex; align-items: center; gap: 10rpx; color: #8D582C; font-size: 25rpx; font-weight: 700; }
.status-dot { background: #ED6A38; width: 10rpx; height: 10rpx; border-radius: 50%; }
.preparation-copy { font-size: 22rpx; color: #7B684F; margin-top: 10rpx; line-height: 1.7; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; font-size: 29rpx; font-weight: 800; margin: 36rpx 0 18rpx; }
.section-caption { font-size: 19rpx; color: #637060; font-weight: 400; white-space: nowrap; }
.steps-card, .rules-card { border-radius: 26rpx; padding: 6rpx 26rpx; background: #fff; border: 1rpx solid #E6EAE0; }
.step-row { display: flex; gap: 22rpx; padding: 26rpx 0; }
.step-row + .step-row { border-top: 1rpx solid #EEF0E8; }
.step-number { background: #EDF3E9; color: #34765B; width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 18rpx; font-size: 23rpx; font-weight: 800; }
.step-copy { flex: 1; min-width: 0; }
.step-title { font-size: 26rpx; font-weight: 700; }
.step-description, .rule-description { font-size: 23rpx; color: #637060; line-height: 1.7; margin-top: 8rpx; }
.rule-row { padding: 23rpx 0; }
.rule-row + .rule-row { border-top: 1rpx solid #EEF0E8; }
.rule-title { font-size: 25rpx; font-weight: 700; }
.existing-shop { border-radius: 26rpx; padding: 26rpx; background: #E6EEE1; margin-top: 26rpx; }
.existing-title { font-size: 27rpx; font-weight: 700; }
.existing-description { color: #52664E; font-size: 23rpx; line-height: 1.7; margin-top: 8rpx; }
.existing-link { min-height: 78rpx; display: flex; align-items: center; gap: 18rpx; color: #34765B; font-size: 24rpx; font-weight: 700; margin-top: 12rpx; }
.page-footnote { text-align: center; font-size: 20rpx; color: #7A8477; margin-top: 38rpx; }
.service-footer { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #E6EAE0; background: #F8F6F1; display: flex; gap: 16rpx; z-index: 10; }
.footer-secondary, .footer-primary { min-height: 92rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; font-size: 25rpx; font-weight: 700; }
.footer-secondary { width: 196rpx; flex-shrink: 0; background: #E8ECE2; color: #52664E; }
.footer-primary { flex: 1; min-width: 0; background: #34765B; color: #fff; }
