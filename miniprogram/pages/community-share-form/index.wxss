page { background: #F8F6F1; color: #26352E; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; }
button { padding: 0; margin: 0; font: inherit; line-height: normal; text-align: left; color: inherit; background: transparent; border: 0; border-radius: 0; overflow: visible; }
button::after { border: none; }
.form-page { padding: 24rpx 32rpx calc(60rpx + env(safe-area-inset-bottom)); }
.form-head { margin-bottom: 24rpx; }
.form-title { font-size: 40rpx; font-weight: 800; }
.form-sub { font-size: 23rpx; color: #66736C; margin-top: 8rpx; }
.card { background: #fff; border: 1rpx solid #E4EAE0; border-radius: 26rpx; padding: 24rpx; margin-bottom: 20rpx; }
.card-title { font-size: 27rpx; font-weight: 800; margin-bottom: 16rpx; }
.input { width: 100%; box-sizing: border-box; min-height: 76rpx; padding: 0 20rpx; border-radius: 18rpx; background: #F4F6F1; font-size: 24rpx; }
.textarea { width: 100%; box-sizing: border-box; min-height: 180rpx; padding: 18rpx 20rpx; border-radius: 18rpx; background: #F4F6F1; font-size: 24rpx; }
.field { display: flex; align-items: center; margin-top: 16rpx; }
.label { width: 150rpx; flex-shrink: 0; font-size: 22rpx; color: #6B756C; }
.options { display: flex; }
.option { padding: 14rpx 30rpx; margin-right: 12rpx; border-radius: 30rpx; background: #ECEEE5; color: #5C685D; font-size: 23rpx; }
.option.chosen { background: #34765B; color: #fff; }
.hint { font-size: 20rpx; color: #8A938A; margin-top: 12rpx; line-height: 1.5; }
.picker-line { display: flex; align-items: center; justify-content: space-between; min-height: 76rpx; padding: 0 20rpx; border-radius: 18rpx; background: #F4F6F1; }
.picker-value { font-size: 24rpx; }
.picker-arrow { color: #9AA49A; font-size: 32rpx; }
.image-row { display: flex; flex-wrap: wrap; }
.image-cell { position: relative; width: 190rpx; margin-right: 14rpx; margin-bottom: 14rpx; }
.image-preview { width: 190rpx; height: 190rpx; border-radius: 18rpx; display: block; }
.image-remove { position: absolute; right: 6rpx; top: 6rpx; padding: 4rpx 12rpx; border-radius: 20rpx; background: rgba(38,53,46,.75); color: #fff; font-size: 18rpx; }
.image-add { width: 190rpx; height: 190rpx; border-radius: 18rpx; background: #EDF3E9; color: #34765B; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 40rpx; }
.image-add text { font-size: 19rpx; margin-top: 6rpx; }
.error-line { padding: 16rpx 20rpx; border-radius: 16rpx; background: #FBE6D6; color: #8A5A33; font-size: 22rpx; margin-bottom: 16rpx; }
.submit-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 96rpx; border-radius: 24rpx; background: #34765B; color: #fff; font-size: 28rpx; font-weight: 800; }
.submit-button[disabled] { background: #B7C2B9; }
.foot-note { text-align: center; color: #8A938A; font-size: 20rpx; margin-top: 20rpx; line-height: 1.6; }
