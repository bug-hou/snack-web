@import "../../styles/snack.wxss";
.address-page{min-height:100vh;background:#FFF9F1;padding:30rpx 30rpx 110rpx;box-sizing:border-box}.heading{padding:22rpx 6rpx 30rpx}.eyebrow{font-size:21rpx;color:#F4654D;font-weight:700}.title{font-size:44rpx;font-weight:800;margin:10rpx 0 8rpx;color:#3B3031}.intro{font-size:23rpx;color:#9A8880}.address-card{background:#fff;border:2rpx solid #F3E8DE;border-radius:24rpx;margin-bottom:18rpx;padding:24rpx}.address-card.active{border-color:#FF8B6B;box-shadow:0 8rpx 24rpx #FF745118}.address-main{padding-bottom:20rpx}.address-top{display:flex;gap:12rpx;align-items:center}.address-tag,.default-tag{font-size:19rpx;color:#D35E4B;background:#FFF0DF;border-radius:10rpx;padding:5rpx 12rpx}.default-tag{background:#E9F5E8;color:#4B9E68}.address-title{font-size:32rpx;font-weight:750;color:#3B3031;margin:18rpx 0 8rpx}.address-person{font-size:23rpx;color:#857771}.address-actions{border-top:1rpx solid #F3E8DE;padding-top:18rpx;display:flex;justify-content:flex-end;gap:40rpx;font-size:22rpx;color:#E46855}.add-button,.save{background:#FF6952;color:#fff;font-size:26rpx;font-weight:700;text-align:center;padding:24rpx;border-radius:20rpx;margin-top:25rpx}.empty,.loading{padding:90rpx 30rpx;text-align:center;color:#988780;font-size:25rpx;line-height:1.6}.error{padding:15rpx 20rpx;background:#FFF0DF;color:#AA533A;font-size:22rpx;border-radius:12rpx;margin-bottom:20rpx}.form-card{padding:24rpx 25rpx 35rpx;background:white;border-radius:25rpx}.form-title{font-size:31rpx;font-weight:800;margin-bottom:20rpx}.field{display:flex;justify-content:space-between;align-items:center;gap:12rpx;padding:23rpx 0;border-bottom:1rpx solid #F5EDE5;font-size:24rpx}.field text{flex-shrink:0}.field input{width:70%;text-align:right;font-size:24rpx}.fixed{color:#EE7157}.option-title{font-size:23rpx;font-weight:650;margin:25rpx 0 15rpx}.options{display:flex;flex-wrap:wrap;gap:13rpx}.option{padding:13rpx 20rpx;background:#FFF0DE;color:#8D7569;border-radius:14rpx;font-size:22rpx}.option.chosen{background:#FF7454;color:#fff}.form-actions{display:flex;align-items:center;gap:15rpx;margin-top:35rpx}.cancel{flex:1;text-align:center;padding:22rpx;background:#FFF0DE;border-radius:16rpx;color:#8D7569}.form-actions .save{flex:2;margin:0;padding:22rpx}
