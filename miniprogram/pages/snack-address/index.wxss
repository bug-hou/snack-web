@import "../../styles/snack.wxss";
.address-page{min-height:100vh;background:#F5F5F5;padding:30rpx 30rpx 110rpx;box-sizing:border-box}.heading{padding:22rpx 6rpx 30rpx}.eyebrow{font-size:21rpx;color:#E1251B;font-weight:700}.title{font-size:44rpx;font-weight:800;margin:10rpx 0 8rpx;color:#1A1A1A}.intro{font-size:23rpx;color:#8D8D8D}.address-card{background:#fff;border:2rpx solid #EEEEEE;border-radius:24rpx;margin-bottom:18rpx;padding:24rpx}.address-card.active{border-color:#E1251B;box-shadow:0 8rpx 24rpx #E1251B18}.address-main{padding-bottom:20rpx}.address-top{display:flex;gap:12rpx;align-items:center}.address-tag,.default-tag{font-size:19rpx;color:#E1251B;background:#FFEFED;border-radius:10rpx;padding:5rpx 12rpx}.default-tag{background:#E9F5E8;color:#4B9E68}.address-title{font-size:32rpx;font-weight:750;color:#1A1A1A;margin:18rpx 0 8rpx}.address-person{font-size:23rpx;color:#7B7B7B}.address-actions{border-top:1rpx solid #EEEEEE;padding-top:18rpx;display:flex;justify-content:flex-end;gap:40rpx;font-size:22rpx;color:#E1251B}.add-button,.save{background:#E1251B;color:#fff;font-size:26rpx;font-weight:700;text-align:center;padding:24rpx;border-radius:20rpx;margin-top:25rpx}.empty,.loading{padding:90rpx 30rpx;text-align:center;color:#8C8C8C;font-size:25rpx;line-height:1.6}.error{padding:15rpx 20rpx;background:#FFEFED;color:#C81623;font-size:22rpx;border-radius:12rpx;margin-bottom:20rpx}.form-card{padding:24rpx 25rpx 35rpx;background:white;border-radius:25rpx}.form-title{font-size:31rpx;font-weight:800;margin-bottom:20rpx}.field{display:flex;justify-content:space-between;align-items:center;gap:12rpx;padding:23rpx 0;border-bottom:1rpx solid #EEEEEE;font-size:24rpx}.field text{flex-shrink:0}.field input{width:70%;text-align:right;font-size:24rpx}.fixed{color:#E1251B}.option-title{font-size:23rpx;font-weight:650;margin:25rpx 0 15rpx}.options{display:flex;flex-wrap:wrap;gap:13rpx}.option{padding:13rpx 20rpx;background:#FFEFED;color:#7B7B7B;border-radius:14rpx;font-size:22rpx}.option.chosen{background:#E1251B;color:#fff}.form-actions{display:flex;align-items:center;gap:15rpx;margin-top:35rpx}.cancel{flex:1;text-align:center;padding:22rpx;background:#FFEFED;border-radius:16rpx;color:#7B7B7B}.form-actions .save{flex:2;margin:0;padding:22rpx}
