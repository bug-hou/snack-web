<view class="address-page">
  <view class="heading">
    <view class="eyebrow">送到家门口</view>
    <view class="title">我的收货地址</view>
    <view class="intro">保利爱尚里 · 仅支持 16 / 17 / 18 栋</view>
  </view>

  <view wx:if="{{error}}" class="error" bindtap="loadAddresses">{{error}}<text wx:if="{{!editing}}"> · 点击重试</text></view>
  <view wx:if="{{loading}}" class="loading">正在加载地址…</view>

  <block wx:elif="{{!editing}}">
    <view wx:for="{{list}}" wx:key="id" class="address-card {{selectedId === item.id ? 'active' : ''}}">
      <view class="address-main" data-id="{{item.id}}" bindtap="choose">
        <view class="address-top">
          <text class="address-tag">{{item.label}}</text>
          <text wx:if="{{selectedId === item.id}}" class="default-tag">当前使用</text>
        </view>
        <view class="address-title">{{item.building}}栋 {{item.room}}</view>
        <view class="address-person">{{item.recipient}}　{{item.phone}}</view>
        <view wx:if="{{item.pickupPhoneLast4}}" class="address-person">取件手机尾号 {{item.pickupPhoneLast4}}</view>
      </view>
      <view class="address-actions">
        <text class="action" data-id="{{item.id}}" bindtap="edit">编辑</text>
        <text class="action danger" data-id="{{item.id}}" bindtap="remove">删除</text>
      </view>
    </view>
    <view wx:if="{{!list.length}}" class="empty">还没有收货地址，添加一次后下单就不用重复填写啦。</view>
    <view class="add-button" bindtap="add">＋ 新增收货地址</view>
  </block>

  <view wx:else class="form-card">
    <view class="form-title">{{form.id ? '编辑收货地址' : '新增收货地址'}}</view>
    <view class="field">
      <text class="label">地址标签</text>
      <input class="input" maxlength="12" placeholder="如 家 / 父母家" value="{{form.label}}" data-key="label" bindinput="update"/>
    </view>
    <view class="field">
      <text class="label">收货人</text>
      <input class="input" maxlength="30" placeholder="请输入收货人姓名" value="{{form.recipient}}" data-key="recipient" bindinput="update"/>
    </view>
    <view class="field">
      <text class="label">手机号码</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{form.phone}}" data-key="phone" bindinput="update"/>
    </view>
    <view class="field">
      <text class="label">取件手机尾号</text>
      <input class="input" type="number" maxlength="4" placeholder="留空则同手机号" value="{{form.pickupPhoneLast4}}" data-key="pickupPhoneLast4" bindinput="update"/>
    </view>
    <view class="field">
      <text class="label">小区</text>
      <text class="fixed">保利爱尚里</text>
    </view>
    <view class="option-title">选择楼栋</view>
    <view class="options">
      <view wx:for="{{buildings}}" wx:key="*this" class="option {{form.building === item ? 'chosen' : ''}}" data-value="{{item}}" bindtap="building">{{item}}栋</view>
    </view>
    <view class="field">
      <text class="label">门牌号</text>
      <input class="input" maxlength="20" placeholder="如 1201" value="{{form.room}}" data-key="room" bindinput="update"/>
    </view>
    <view class="option-title">送达时如何联系您？</view>
    <view class="options">
      <view wx:for="{{preferences}}" wx:key="value" class="option {{form.contactPreference === item.value ? 'chosen' : ''}}" data-value="{{item.value}}" bindtap="preference">{{item.label}}</view>
    </view>
    <view class="form-actions">
      <view class="cancel" bindtap="closeForm">取消</view>
      <view class="save" bindtap="save">{{saving ? '保存中…' : '保存并使用'}}</view>
    </view>
  </view>
</view>
