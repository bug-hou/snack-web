@import "../../styles/snack.wxss";
.checkout-page { padding-bottom: 240rpx; }
.preview-warning { background: #FBE6D6; color: #8A5A33; border-radius: 18rpx; padding: 20rpx 22rpx; font-size: 22rpx; line-height: 1.55; margin-bottom: 20rpx; }
.form-card { background: #fff; border: 1rpx solid #E4EAE0; border-radius: 26rpx; padding: 6rpx 26rpx 20rpx; margin-bottom: 18rpx; }
.form-heading { font-size: 27rpx; font-weight: 800; padding: 26rpx 0 10rpx; display: flex; align-items: center; gap: 14rpx; }
.form-index { font-size: 19rpx; color: #34765B; font-weight: 800; letter-spacing: 1rpx; }
.form-optional { margin-left: auto; font-size: 20rpx; color: #8A938A; font-weight: 400; }
.form-field { min-height: 92rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid #EEF1EA; font-size: 23rpx; }
.form-field.last { border-bottom: 0; }
.field-label { min-width: 112rpx; flex-shrink: 0; color: #6B756C; }
.form-field input { flex: 1; text-align: right; color: #26352E; font-size: 22rpx; }
.delivery-selector { border-bottom: 1rpx solid #EEF1EA; }
.picker-value { color: #4C5B50; }
.checkout-item { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0; font-size: 22rpx; color: #5C685D; }
.checkout-total { border-top: 1rpx solid #EEF1EA; padding: 22rpx 0 6rpx; display: flex; justify-content: space-between; font-size: 27rpx; font-weight: 800; color: #26352E; }
.checkout-total text:last-child { color: #AF441F; }
.checkout-footnote { padding: 4rpx 0 20rpx; color: #8A938A; text-align: right; font-size: 19rpx; }
.checkout-footer { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-top: 1rpx solid #E4EAE0; padding: 16rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 20rpx; justify-content: space-between; }
.checkout-total-price { font-size: 20rpx; color: #6B756C; }
.checkout-total-price text { display: block; font-size: 32rpx; font-weight: 800; color: #AF441F; }
.disabled-action { background: #B7C2B9; color: #fff; border-radius: 22rpx; min-width: 300rpx; text-align: center; padding: 24rpx 8rpx; font-size: 24rpx; font-weight: 700; }
.enabled-action { background: #34765B; color: #fff; }
.time-reset { min-height: 72rpx; justify-content: flex-end; color: #34765B; font-size: 22rpx; }
.building-field { align-items: center; }
.building-options { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 12rpx; }
.building-option { background: #ECEEE5; color: #5C685D; border-radius: 30rpx; padding: 12rpx 24rpx; font-size: 22rpx; }
.building-option.selected, .contact-option.selected { background: #34765B; color: #fff; }
.contact-heading { font-size: 22rpx; font-weight: 700; color: #6B756C; padding: 22rpx 0 12rpx; }
.contact-options { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 18rpx; }
.checkout-address { padding: 12rpx 0 24rpx; }
.checkout-address-title { color: #26352E; font-weight: 800; font-size: 28rpx; display: flex; align-items: center; justify-content: space-between; }
.checkout-address-title text { color: #34765B; font-size: 22rpx; font-weight: 700; }
.checkout-address-sub { margin-top: 8rpx; font-size: 22rpx; color: #6B756C; }
