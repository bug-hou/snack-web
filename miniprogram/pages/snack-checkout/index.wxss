@import "../../styles/snack.wxss";
.checkout-page { padding-bottom: 230rpx; }.preview-warning { background: #FFEFED; border-radius: 20rpx; padding: 23rpx; font-size: 22rpx; line-height: 1.55; color: #C81623; margin-bottom: 22rpx; }.form-card { background: #fff; border-radius: 24rpx; padding: 0 26rpx; margin-bottom: 19rpx; }.form-heading { font-size: 27rpx; font-weight: 700; padding: 26rpx 0 10rpx; display: flex; align-items: center; gap: 14rpx; }.form-index { font-size: 19rpx; color: #C81623; }.form-optional { margin-left: auto; font-size: 20rpx; color: #A2A2A2; font-weight: 400; }.form-field { min-height: 92rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid #EEEEEE; font-size: 23rpx; }.form-field.last { border-bottom: 0; }.field-label { min-width: 112rpx; flex-shrink: 0; }.form-field input { flex: 1; text-align: right; color: #1A1A1A; font-size: 22rpx; }.delivery-selector { border-bottom: 1rpx solid #EEEEEE; }.picker-value { color: #858585; }.checkout-item { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0; font-size: 22rpx; color: #717171; }.checkout-total { border-top: 1rpx solid #EEEEEE; padding: 21rpx 0 4rpx; display: flex; justify-content: space-between; font-size: 27rpx; font-weight: 700; }.checkout-total text:last-child { color: #C81623; }.checkout-footnote { padding: 4rpx 0 24rpx; color: #A0A0A0; text-align: right; font-size: 19rpx; }.checkout-footer { position: fixed; left: 0; right: 0; bottom: 0; background: white; border-top: 1rpx solid #EEEEEE; padding: 16rpx 30rpx calc(20rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 20rpx; justify-content: space-between; }.checkout-total-price { font-size: 20rpx; color: #878787; }.checkout-total-price text { display: block; font-size: 31rpx; font-weight: 800; color: #C81623; }.disabled-action { background: #D9D9D9; color: #6A6A6A; border-radius: 22rpx; min-width: 284rpx; text-align: center; padding: 24rpx 8rpx; font-size: 24rpx; font-weight: 700; }.enabled-action { background: #E1251B; color: white; box-shadow: 0 8rpx 18rpx rgba(225, 37, 27,.18); }
.preview-warning { background: #FFEFED; color: #B54708; }
.form-index, .checkout-total text:last-child, .checkout-total-price text { color: #E1251B; }
.time-reset { min-height: 72rpx; justify-content: flex-end; color: #E1251B; font-size: 22rpx; }
.building-field { align-items: center; }
.building-options { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 12rpx; }
.building-option { background: #FFEFED; color: #6B6B6B; border-radius: 14rpx; padding: 12rpx 15rpx; font-size: 22rpx; }
.building-option.selected, .contact-option.selected { background: #E1251B; color: #fff; }
.contact-heading { font-size: 23rpx; font-weight: 600; padding: 23rpx 0 12rpx; }
.contact-options { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 18rpx; }
.checkout-address { padding: 12rpx 0 27rpx; }
.checkout-address-title { color: #1A1A1A; font-weight: 800; font-size: 31rpx; display: flex; align-items: center; justify-content: space-between; }
.checkout-address-title text { color: #E1251B; font-size: 22rpx; font-weight: 600; }
.checkout-address-sub { margin-top: 8rpx; font-size: 23rpx; color: #848484; }
