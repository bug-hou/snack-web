@import "../../styles/snack.wxss";
.checkout-page { padding-bottom: 230rpx; }.preview-warning { background: #FAE9DF; border-radius: 20rpx; padding: 23rpx; font-size: 22rpx; line-height: 1.55; color: #A1533C; margin-bottom: 22rpx; }.form-card { background: #fff; border-radius: 24rpx; padding: 0 26rpx; margin-bottom: 19rpx; }.form-heading { font-size: 27rpx; font-weight: 700; padding: 26rpx 0 10rpx; display: flex; align-items: center; gap: 14rpx; }.form-index { font-size: 19rpx; color: #B6523B; }.form-optional { margin-left: auto; font-size: 20rpx; color: #AAA49A; font-weight: 400; }.form-field { min-height: 92rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid #F3EEE7; font-size: 23rpx; }.form-field.last { border-bottom: 0; }.field-label { min-width: 112rpx; flex-shrink: 0; }.form-field input { flex: 1; text-align: right; color: #38362E; font-size: 22rpx; }.delivery-selector { border-bottom: 1rpx solid #F3EEE7; }.picker-value { color: #8C867D; }.checkout-item { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0; font-size: 22rpx; color: #77716A; }.checkout-total { border-top: 1rpx solid #EFEAE2; padding: 21rpx 0 4rpx; display: flex; justify-content: space-between; font-size: 27rpx; font-weight: 700; }.checkout-total text:last-child { color: #B54E39; }.checkout-footnote { padding: 4rpx 0 24rpx; color: #A8A198; text-align: right; font-size: 19rpx; }.checkout-footer { position: fixed; left: 0; right: 0; bottom: 0; background: white; border-top: 1rpx solid #EFEAE2; padding: 16rpx 30rpx calc(20rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 20rpx; justify-content: space-between; }.checkout-total-price { font-size: 20rpx; color: #8D8881; }.checkout-total-price text { display: block; font-size: 31rpx; font-weight: 800; color: #B54E39; }.disabled-action { background: #DEDCD4; color: #706D65; border-radius: 22rpx; min-width: 284rpx; text-align: center; padding: 24rpx 8rpx; font-size: 24rpx; font-weight: 700; }.enabled-action { background: #FF654E; color: white; box-shadow: 0 8rpx 18rpx rgba(255,101,78,.18); }
.preview-warning { background: #FFF0D4; color: #A5682F; }
.form-index, .checkout-total text:last-child, .checkout-total-price text { color: #F25B4C; }
.building-field { align-items: center; }
.building-options { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 12rpx; }
.building-option { background: #FFF4E6; color: #76665F; border-radius: 14rpx; padding: 12rpx 15rpx; font-size: 22rpx; }
.building-option.selected, .contact-option.selected { background: #FF7451; color: #fff; }
.contact-heading { font-size: 23rpx; font-weight: 600; padding: 23rpx 0 12rpx; }
.contact-options { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 18rpx; }
.checkout-address { padding: 12rpx 0 27rpx; }
.checkout-address-title { color: #3D3432; font-weight: 800; font-size: 31rpx; display: flex; align-items: center; justify-content: space-between; }
.checkout-address-title text { color: #F06B52; font-size: 22rpx; font-weight: 600; }
.checkout-address-sub { margin-top: 8rpx; font-size: 23rpx; color: #908179; }
