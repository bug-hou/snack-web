<view class="snack-page checkout-page">
  <view class="page-lead"><view class="small-kicker">保利爱尚里 · 送货上门</view><view class="page-title">确认订单<text class="title-period">.</text></view><view class="page-sub">{{directPurchase ? '立即购买' : '购物车结算'}} · 送达后线下付款</view></view>
  <view wx:if="{{loadError || (configReady && !ordersEnabled)}}" class="preview-warning">{{loadError || shopNotice}}</view>
  <view class="form-card"><view class="form-heading"><text class="form-index">01</text> 送达地址</view><view class="checkout-address" bindtap="goAddress"><block wx:if="{{selectedAddress}}"><view class="checkout-address-title">{{selectedAddress.building}}栋 {{selectedAddress.room}} <text>切换　›</text></view><view class="checkout-address-sub">{{selectedAddress.recipient}}　{{selectedAddress.phone}}</view><view class="checkout-address-sub">{{selectedAddress.contactPreference === 'call' ? '到达后打电话' : selectedAddress.contactPreference === 'no_knock' ? '不要敲门' : '请敲门'}}</view></block><view wx:else class="checkout-address-title">＋ 添加收货地址　›</view></view></view>
  <view class="form-card"><view class="form-heading"><text class="form-index">02</text> 配送偏好</view><picker mode="multiSelector" range="{{timeRange}}" value="{{timeIndex}}" bindchange="onTimeChange"><view class="form-field delivery-selector"><text>期望送达</text><text class="picker-value">{{deliveryText}}　›</text></view></picker><view wx:if="{{deliveryAt}}" class="form-field time-reset" bindtap="useAsap"><text>改为尽快送达</text></view><view class="form-field last"><view class="field-label">备注</view><input value="{{note}}" maxlength="100" placeholder="如有门禁等特殊说明，请写在这里" bindinput="onNote" /></view></view>
  <view class="form-card"><view class="form-heading"><text class="form-index">03</text> 商品清单</view><view wx:if="{{loading}}" class="checkout-item"><text>正在加载商品…</text></view><view wx:for="{{items}}" wx:key="id" class="checkout-item"><text>{{item.name}} ×{{item.quantity}}</text><text>¥{{item.subtotal}}</text></view><view class="checkout-item"><text>商品小计</text><text>¥{{total}}</text></view><view class="checkout-item"><text>上门配送费</text><text>¥{{deliveryFee}}</text></view><view class="checkout-total"><text>订单合计</text><text>¥{{payable}}</text></view><view wx:if="{{belowMinimum && configReady}}" class="checkout-footnote">商品满 ¥{{minOrder}} 起送，还差一点点</view><view wx:else class="checkout-footnote"></view></view>
  <view class="checkout-footer"><view class="checkout-total-price">订单合计 <text>¥{{payable}}</text></view><view class="disabled-action {{canOrder ? 'enabled-action' : ''}}" bindtap="submitOrder">{{submitting ? '正在提交…' : !selectedAddress ? '先添加收货地址' : !configReady ? '正在确认…' : belowMinimum ? '未达到起送金额' : ordersEnabled ? '提交订单 · 货到付款' : '暂不接单'}}</view></view>
</view>
