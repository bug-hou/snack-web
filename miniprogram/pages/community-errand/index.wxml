<view class="errand-page">
  <view class="errand-head">
    <view class="errand-title">{{title}}</view>
    <view class="errand-sub">{{subtitle}}</view>
    <view wx:if="{{config}}" class="status-bar {{statusTone}}">
      <view class="status-dot"></view>
      <text class="status-text">{{statusText}}</text>
      <text class="status-time">服务时间 {{serviceTime}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="errand-message">正在加载服务信息…</view>
  <view wx:elif="{{error}}" class="errand-message">{{error}}</view>
  <block wx:else>
    <view class="card">
      <view class="card-head">
        <text class="card-title">送到哪里</text>
        <text class="card-action" bindtap="goAddress">{{addresses.length ? '更换' : '去添加'}}</text>
      </view>
      <view class="address-box">
        <view class="address-strong">{{addressText}}</view>
        <view class="address-sub">{{addressPerson}}</view>
        <view wx:if="{{addressTail}}" class="tail-line">取件手机尾号 <text class="tail-value">{{addressTail}}</text></view>
      </view>
    </view>

    <block wx:if="{{type === 'express'}}">
      <view class="card">
        <view class="card-head">
          <text class="card-title">快递站点</text>
          <text class="card-note">只支持选择，站点由商家配置</text>
        </view>
        <view wx:if="{{stations.length}}" class="chip-wrap">
          <view wx:for="{{stations}}" wx:key="*this" class="chip {{station === item ? 'chosen' : ''}}" data-value="{{item}}" bindtap="pickStation">{{item}}</view>
        </view>
        <view wx:else class="empty-line">商家还没有配置快递站点，暂时无法下单</view>
      </view>

      <view class="card">
        <view class="card-head">
          <text class="card-title">包裹信息</text>
          <text class="card-action" bindtap="openSms">粘贴短信识别</text>
        </view>

        <view wx:if="{{smsOpen}}" class="sms-box">
          <textarea class="sms-input" value="{{smsText}}" maxlength="2000" placeholder="把快递短信整段粘贴进来，可以同时识别多个包裹" bindinput="smsInput"/>
          <view class="sms-sample">示例：{{smsSample}}</view>
          <view class="sms-actions">
            <view class="sms-btn ghost" bindtap="readClipboard">读取剪贴板</view>
            <view wx:if="{{smsText}}" class="sms-btn ghost" bindtap="clearSms">清空</view>
            <view class="sms-btn primary" bindtap="parseSms">识别并填入</view>
            <view class="sms-btn ghost" bindtap="closeSms">收起</view>
          </view>
        </view>
        <view wx:elif="{{parseNote}}" class="parse-note {{parseTone}}">{{parseNote}}</view>

        <view wx:for="{{packages}}" wx:key="index" class="pkg">
          <view class="pkg-head">
            <text class="pkg-index">包裹 {{index + 1}}</text>
            <text wx:if="{{packages.length > 1}}" class="pkg-remove" data-index="{{index}}" bindtap="removePackage">移除</text>
          </view>
          <view class="pkg-row">
            <text class="pkg-label">取件码</text>
            <input class="pkg-input" value="{{item.code}}" maxlength="32" placeholder="如 8-1-2345" data-group="package" data-index="{{index}}" data-key="code" bindinput="input"/>
          </view>
          <view class="pkg-row">
            <text class="pkg-label">手机尾号</text>
            <input class="pkg-input" type="number" value="{{item.phoneLast4}}" maxlength="4" placeholder="手机号后4位" data-group="package" data-index="{{index}}" data-key="phoneLast4" bindinput="input"/>
          </view>
          <view class="size-row">
            <view wx:for="{{sizes}}" wx:for-item="size" wx:for-index="si" wx:key="value" class="size {{item.size === size.value ? 'chosen' : ''}}" data-index="{{index}}" data-value="{{size.value}}" bindtap="pickSize">
              <text class="size-label">{{size.label}}</text>
              <text class="size-hint">{{size.hint}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{packages.length < maxPackages}}" class="add-more" bindtap="addPackage">＋ 再加一个包裹（最多 {{maxPackages}} 个）</view>
      </view>
    </block>

    <block wx:else>
      <view class="card">
        <view class="card-head"><text class="card-title">代买清单</text></view>
        <view class="hint">{{config ? config.store : '京东便利店'}}等非官方代买，商品金额按实际门店结算</view>
        <view wx:for="{{items}}" wx:key="index" class="pkg">
          <view class="pkg-head">
            <text class="pkg-index">商品 {{index + 1}}</text>
            <text wx:if="{{items.length > 1}}" class="pkg-remove" data-index="{{index}}" bindtap="removeItem">移除</text>
          </view>
          <view class="pkg-row">
            <text class="pkg-label">名称</text>
            <input class="pkg-input" value="{{item.name}}" maxlength="40" placeholder="如 可口可乐" data-group="item" data-index="{{index}}" data-key="name" bindinput="input"/>
          </view>
          <view class="pkg-row">
            <text class="pkg-label">规格</text>
            <input class="pkg-input" value="{{item.spec}}" maxlength="30" placeholder="选填，如 500ml" data-group="item" data-index="{{index}}" data-key="spec" bindinput="input"/>
          </view>
          <view class="pkg-row">
            <text class="pkg-label">数量</text>
            <input class="pkg-input" type="number" value="{{item.quantity}}" maxlength="2" placeholder="1" data-group="item" data-index="{{index}}" data-key="quantity" bindinput="input"/>
          </view>
        </view>
        <view class="add-more" bindtap="addItem">＋ 再加一项（最多 10 项）</view>
        <view class="switch-line" bindtap="toggleSubstitute"><text>缺货时允许同类替换</text><text class="switch {{allowSubstitute ? 'on' : ''}}">{{allowSubstitute ? '已开启' : '已关闭'}}</text></view>
        <view class="pkg-row">
          <text class="pkg-label">预估金额</text>
          <input class="pkg-input" type="digit" value="{{budget}}" placeholder="选填，便于店主备货" bindinput="budgetInput"/>
        </view>
      </view>
    </block>

    <view class="card">
      <view class="card-head">
        <text class="card-title">送达备注</text>
        <text class="card-note">选填</text>
      </view>
      <view class="chip-wrap">
        <view wx:for="{{quickNotes}}" wx:key="text" class="chip small {{item.active ? 'chosen' : ''}}" data-value="{{item.text}}" bindtap="toggleNote">{{item.text}}</view>
      </view>
      <textarea class="textarea" value="{{note}}" maxlength="100" placeholder="也可以自己写，如放门口、稍后电话联系" bindinput="noteInput"/>
    </view>

    <view class="fee-card">
      <view class="fee-row">
        <text>{{type === 'express' ? '代取跑腿费' : '代买跑腿费'}}</text>
        <text class="fee-value">¥{{feeText}}</text>
      </view>
      <view wx:for="{{feeDetail}}" wx:key="label" class="fee-line"><text>{{item.label}}</text><text>¥{{item.value}}</text></view>
      <view class="fee-rule">{{feeRule}}</view>
      <view wx:if="{{type === 'purchase'}}" class="fee-rule">商品金额由店主按实际购买报价，确认后再配送</view>
    </view>

    <button class="submit-button" disabled="{{submitting || !config || !config.enabled}}" bindtap="submit">{{submitting ? '提交中…' : '提交服务订单'}}</button>
    <view class="foot-note">货到付款 · 服务时间以店铺配置为准</view>
  </block>
</view>
