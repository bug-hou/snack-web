<view class="community-page">
  <view class="community-header">
    <view class="community-brand"><view class="brand-mark">里</view><view><view class="brand-name">爱尚里生活</view><view class="brand-kicker">家门口的小事，一起办好</view></view></view>
    <button class="header-orders" bindtap="goOrders" aria-label="查看我的订单"><image src="/images/community/clipboard-list.svg"/><text>我的订单</text></button>
  </view>
  <scroll-view scroll-y="{{true}}" class="shop-scroll" scroll-into-view="{{scrollTarget}}" scroll-with-animation="{{true}}" enable-back-to-top="{{true}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="refreshCommunity">
    <view class="shop-content">
      <button class="address-entry" bindtap="goAddress" aria-label="管理收货地址">
        <image class="address-pin" src="/images/community/map-pin.svg"/>
        <view class="address-copy"><view class="address-current">{{addressText}}</view><view class="address-sub">{{addressHint}}</view></view><text class="address-arrow">›</text>
      </button>
      <view class="community-intro">
        <view class="intro-copy"><view class="intro-kicker">YOUR NEIGHBOURHOOD, CLOSER.</view><view class="intro-title">生活的小事<text>，</text><view>不用跑远。</view></view><view class="intro-desc">取快递 · 买日常 · 分享好物</view></view>
        <view class="neighbour-art" aria-hidden="{{true}}"><view class="art-sun"></view><view class="art-house house-back"><view class="house-window"></view></view><view class="art-house house-front"><view class="house-window"></view><view class="house-door"></view></view><view class="art-tree"></view><view class="art-ground"></view><view class="art-label">HELLO, NEIGHBOUR</view></view>
      </view>
      <view class="service-heading"><text>今天需要什么？</text><text class="service-heading-note">社区服务</text></view>
      <view class="service-grid">
        <button wx:for="{{services}}" wx:key="id" class="service-card service-{{item.id}}" data-id="{{item.id}}" bindtap="openService" hover-class="service-pressed" aria-label="{{item.title}}，查看服务说明">
          <view class="service-copy"><text class="service-label">{{item.label}}</text><view class="service-title">{{item.shortTitle}}</view><view wx:if="{{item.id === 'purchase'}}" class="service-subtitle">京东便利店 · 非官方代买</view><view wx:else class="service-subtitle">{{item.subtitle}}</view><view class="service-action">了解服务 <text>↗</text></view></view>
          <view class="service-art"><view class="icon-backplate"></view><image src="/images/community/{{item.icon}}.svg" mode="aspectFit"/></view>
        </button>
      </view>
      <view class="service-notice"><view class="notice-dot"></view><text>新服务筹备中，开放时间与费用待确认</text></view>
      <view class="section-head"><view><view class="section-eyebrow">PASS IT ON</view><view class="section-name">邻里的闲置，也有新生活</view></view><button class="section-link" data-id="secondhand" bindtap="openService">逛一逛 ›</button></view>
      <view class="sharing-card">
        <view class="sharing-symbol"><image src="/images/community/repeat-2.svg"/></view>
        <view class="sharing-copy"><view class="sharing-title">让好物，在小区里接力</view><view class="sharing-tags"><text>二手转让</text><text>免费分享</text><text>邻里交接</text></view><view class="sharing-desc">分享区正在筹备，暂未开放物品发布</view></view>
        <button class="sharing-action" bindtap="showSharingGuide"><image src="/images/community/plus.svg"/><text>发布须知</text></button>
      </view>
      <view id="community-catalog" class="section-head catalog-head"><view><view class="section-eyebrow">DAILY ESSENTIALS</view><view class="section-name">便利铺现货</view></view><text wx:if="{{shopStatus}}" class="shop-state">{{shopStatus}}</text></view>
      <view class="catalog-caption">原口袋便利铺商品 · 与便利店代买服务分开</view>
      <scroll-view wx:if="{{featured.length}}" scroll-x="{{true}}" class="featured-scroll" show-scrollbar="{{false}}">
        <view wx:for="{{featured}}" wx:key="id" class="featured-item">
          <view class="featured-art tone-{{item.tone}}"><image wx:if="{{item.image}}" class="featured-image" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}"/><view wx:else class="mini-pack"><text>{{item.initials}}</text></view></view>
          <view class="featured-label">{{item.name}}</view><view class="featured-price">¥{{item.price}} <button data-id="{{item.id}}" bindtap="add" aria-label="加入购物车">＋</button></view>
        </view>
      </scroll-view>
      <view class="search-box"><view class="search-icon"></view><input class="search-input" value="{{keyword}}" placeholder="搜索鸡蛋、牛奶、日用品" placeholder-class="search-placeholder" bindinput="onSearch" confirm-type="search"/><text wx:if="{{keyword}}" class="clear-search" bindtap="clearSearch">清除</text></view>
      <scroll-view scroll-x="{{true}}" class="category-scroll" show-scrollbar="{{false}}"><view wx:for="{{categories}}" wx:key="id" class="category-chip {{activeCategory === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectCategory">{{item.name}}</view></scroll-view>
      <view class="product-grid">
        <view wx:for="{{products}}" wx:key="id" class="product-card">
          <view class="product-art tone-{{item.tone}}"><image wx:if="{{item.image}}" class="product-image" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}"/><view wx:else class="product-pack"><view class="pack-name">{{item.initials}}</view></view><view wx:if="{{item.label}}" class="product-tag">{{item.label}}</view></view>
          <view class="product-name">{{item.name}}</view><view class="product-spec">{{item.spec}}</view>
          <view class="product-bottom"><view class="product-price"><text>¥</text>{{item.price}}</view><view class="qty-controls"><view wx:if="{{item.quantity}}" class="qty-minus" data-id="{{item.id}}" bindtap="reduce">－</view><text wx:if="{{item.quantity}}" class="qty-value">{{item.quantity}}</text><view class="qty-plus" data-id="{{item.id}}" bindtap="add">＋</view></view></view>
          <view class="buy-now" data-id="{{item.id}}" bindtap="buyNow">立即购买</view>
        </view>
      </view>
      <view wx:if="{{loading}}" class="empty-results">正在加载商品…</view>
      <view wx:elif="{{catalogError}}" class="empty-results" bindtap="retryCatalog">{{catalogError}} · 点击重试</view>
      <view wx:elif="{{products.length === 0}}" class="empty-results">{{keyword ? '没找到这件商品，换个关键词试试' : '暂时没有上架商品，稍后再来看看'}}</view>
    </view>
  </scroll-view>
  <view wx:if="{{count}}" class="floating-cart" bindtap="openCart"><view><view class="floating-count">已选 {{count}} 件</view><view class="floating-price">合计 ¥{{total}}</view></view><view class="floating-button">查看购物车　→</view></view>
</view>
