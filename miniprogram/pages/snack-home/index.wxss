page { background: #F8F6F1; color: #26352E; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; }
.community-page { width: 100%; min-height: 100vh; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); background: #F8F6F1; }
.community-header { width: 100%; padding: 24rpx 32rpx 14rpx; display: flex; align-items: center; justify-content: space-between; }
.community-brand { display: flex; align-items: center; flex: 1; min-width: 0; margin-right: 16rpx; }
.brand-mark { width: 68rpx; height: 68rpx; border-radius: 22rpx 22rpx 22rpx 6rpx; background: #34765B; color: #fff; font-size: 34rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-right: 16rpx; }
.brand-name { font-size: 34rpx; font-weight: 800; letter-spacing: 1rpx; }
.brand-kicker { font-size: 19rpx; color: #66736C; margin-top: 4rpx; }
.header-orders { min-width: 96rpx; display: flex; flex-direction: column; align-items: center; font-size: 18rpx; color: #4C5B50; }
.header-orders image { width: 34rpx; height: 34rpx; margin-bottom: 6rpx; }
.shop-content { padding: 4rpx 32rpx 40rpx; }
.compliance-banner { margin-bottom: 18rpx; padding: 16rpx 20rpx; border-radius: 18rpx; background: #F1EFE5; color: #6C766B; font-size: 19rpx; line-height: 1.6; }
.address-entry { display: flex; align-items: center; padding: 18rpx 20rpx; border: 1rpx solid #E4EAE0; border-radius: 22rpx; background: #fff; }
.address-pin { width: 34rpx; height: 34rpx; margin-right: 14rpx; flex-shrink: 0; }
.address-copy { flex: 1; min-width: 0; overflow: hidden; }
.address-current { font-size: 24rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.address-sub { font-size: 19rpx; color: #66736C; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.address-arrow { color: #8A958B; font-size: 34rpx; margin-left: 10rpx; }
.community-intro { width: 100%; display: flex; align-items: center; padding: 30rpx; margin: 20rpx 0 8rpx; border-radius: 26rpx; background: #F1EFE5; }
.intro-copy { flex: 1; min-width: 0; }
.intro-kicker { font-size: 15rpx; line-height: 1.5; letter-spacing: 1rpx; color: #34765B; font-weight: 700; }
.intro-title { font-size: 46rpx; font-weight: 800; line-height: 1.24; margin-top: 12rpx; letter-spacing: -1rpx; }
.intro-title text { color: #ED6A38; }
.intro-desc { font-size: 22rpx; line-height: 1.5; color: #66736C; margin-top: 12rpx; }
.neighbour-art { position: relative; width: 148rpx; height: 174rpx; margin-left: 12rpx; flex-shrink: 0; }
.art-circle { position: absolute; right: 0; top: 6rpx; width: 118rpx; height: 118rpx; border-radius: 50%; background: #F6D781; }
.art-circle.small { left: 0; top: 74rpx; width: 74rpx; height: 74rpx; background: #DCE6D4; }
.art-label { position: absolute; left: 0; right: 0; bottom: 0; text-align: center; font-size: 12rpx; letter-spacing: 1rpx; color: #6C806F; }
.service-heading { display: flex; align-items: center; justify-content: space-between; margin: 30rpx 0 16rpx; font-size: 28rpx; font-weight: 800; }
.service-heading-note { font-size: 19rpx; font-weight: 400; color: #66736C; }
.service-list { overflow: hidden; border-radius: 26rpx; background: #fff; border: 1rpx solid #E4EAE0; }
.service-card { display: flex; align-items: center; width: 100%; padding: 26rpx 24rpx; border-top: 1rpx solid #EEF1EA; }
.service-card:first-child { border-top: 0; }
.service-icon { width: 76rpx; height: 76rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; flex-shrink: 0; background: #FBE6D6; }
.service-purchase .service-icon { background: #F3EDD9; }
.service-secondhand .service-icon { background: #E6EEE1; }
.service-icon image { width: 42rpx; height: 42rpx; }
.service-copy { flex: 1; min-width: 0; overflow: hidden; }
.service-title-row { display: flex; align-items: center; }
.service-title { font-size: 28rpx; font-weight: 800; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.service-state { margin-left: 12rpx; padding: 4rpx 12rpx; border-radius: 20rpx; font-size: 18rpx; font-weight: 700; flex-shrink: 0; background: #EFEFEA; color: #8A938A; }
.service-state.on { background: #E6EEE1; color: #34765B; }
.service-state.wait { background: #F1E4D6; color: #8A5A33; }
.service-state.off { background: #EFEFEA; color: #9AA49A; }
.service-subtitle { font-size: 20rpx; color: #6B756C; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.service-arrow { color: #9AA49A; font-size: 34rpx; margin-left: 14rpx; }
.service-pressed { background: #F4F6F1; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 40rpx 0 18rpx; }
.section-eyebrow { font-size: 15rpx; letter-spacing: 2rpx; font-weight: 700; color: #34765B; }
.section-name { font-size: 29rpx; font-weight: 800; margin-top: 7rpx; }
.section-link { font-size: 20rpx; color: #34765B; padding: 16rpx 0; }
.catalog-head { margin-top: 44rpx; }
/* 从左到右排列：不足 3 个时靠左对齐，不要用 space-between 把卡片撑到两端 */
.share-row { display: flex; flex-wrap: wrap; justify-content: flex-start; }
.share-card { width: calc((100% - 24rpx) / 3); margin-right: 12rpx; background: #fff; border: 1rpx solid #E4EAE0; border-radius: 22rpx; padding: 12rpx; overflow: hidden; }
.share-card:last-child { margin-right: 0; }
.share-art { height: 150rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #EDEFE6; color: #7C877D; font-size: 26rpx; font-weight: 800; }
.share-image { width: 100%; height: 100%; display: block; }
.share-title { font-size: 22rpx; font-weight: 700; margin-top: 10rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.share-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 6rpx; }
.share-mode { font-size: 17rpx; color: #34765B; }
.share-price { font-size: 20rpx; font-weight: 700; color: #AF441F; }
.sharing-card { display: flex; align-items: center; background: #fff; border: 1rpx solid #E4EAE0; border-radius: 26rpx; padding: 24rpx; }
.sharing-card:active { background: #F4F6F1; }
.sharing-symbol { width: 66rpx; height: 66rpx; border-radius: 22rpx; background: #EDF3E9; display: flex; align-items: center; justify-content: center; margin-right: 18rpx; flex-shrink: 0; }
.sharing-symbol image { width: 38rpx; height: 38rpx; }
.sharing-copy { flex: 1; min-width: 0; }
.sharing-title { font-size: 25rpx; font-weight: 700; }
.sharing-desc { font-size: 19rpx; color: #69746B; margin-top: 8rpx; line-height: 1.5; }
.publish-button { display: flex; align-items: center; justify-content: center; width: 100%; margin-top: 16rpx; min-height: 88rpx; border-radius: 22rpx; background: #EDF3E9; color: #34765B; font-size: 25rpx; font-weight: 700; }
.publish-button image { width: 28rpx; height: 28rpx; margin-right: 10rpx; }
.forum-entry { display: flex; align-items: center; background: #fff; border: 1rpx solid #E4EAE0; border-radius: 26rpx; padding: 24rpx 26rpx; }
.forum-entry-pressed { background: #F4F6F1; }
.forum-entry-copy { flex: 1; min-width: 0; }
.forum-entry-title { font-size: 26rpx; font-weight: 800; }
.forum-entry-desc { font-size: 20rpx; color: #6B756C; margin-top: 8rpx; }
.forum-entry-arrow { font-size: 36rpx; color: #9AA49A; margin-left: 14rpx; }
.shop-state { font-size: 20rpx; color: #34765B; padding: 7rpx 14rpx; background: #E6EEE1; border-radius: 30rpx; }
.catalog-caption { font-size: 19rpx; color: #69746B; margin: -4rpx 0 20rpx; }
.featured-scroll { white-space: nowrap; margin-bottom: 24rpx; }
.featured-item { width: 208rpx; display: inline-block; vertical-align: top; margin-right: 14rpx; }
.featured-art { height: 158rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.featured-image, .product-image { width: 100%; height: 100%; display: block; }
.mini-pack { width: 70rpx; height: 105rpx; display: flex; align-items: center; justify-content: center; background: #34765B; color: #fff; border-radius: 10rpx; transform: rotate(-8deg); font-size: 22rpx; font-weight: 700; }
.featured-label { font-size: 23rpx; font-weight: 700; margin-top: 10rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.featured-price { display: flex; align-items: center; justify-content: space-between; font-size: 24rpx; font-weight: 700; color: #AF441F; }
.featured-add { width: 70rpx; min-height: 72rpx; display: flex; justify-content: center; align-items: center; flex-shrink: 0; font-size: 30rpx; }
.search-box { display: flex; align-items: center; min-height: 82rpx; background: #fff; border: 1rpx solid #E4E7DE; border-radius: 20rpx; padding: 0 22rpx; }
.search-icon { width: 23rpx; height: 23rpx; border: 3rpx solid #7C877D; border-radius: 50%; position: relative; flex-shrink: 0; margin-right: 18rpx; }
.search-icon::after { content: ''; position: absolute; width: 12rpx; height: 3rpx; background: #7C877D; transform: rotate(45deg); right: -9rpx; bottom: -4rpx; }
.search-input { flex: 1; font-size: 24rpx; min-width: 0; }
.search-placeholder { color: #7D857C; }
.clear-search { font-size: 22rpx; color: #34765B; padding: 20rpx 0; }
.category-scroll { white-space: nowrap; margin: 20rpx 0 24rpx; }
.category-chip { display: inline-block; padding: 14rpx 24rpx; margin-right: 12rpx; border-radius: 30rpx; background: #ECEEE5; color: #5C685D; font-size: 22rpx; }
.category-chip.selected { background: #34765B; color: #fff; }
.product-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.product-card { width: calc(50% - 9rpx); box-sizing: border-box; padding: 12rpx 12rpx 18rpx; border-radius: 24rpx; background: #fff; margin-bottom: 18rpx; }
.product-art { height: 226rpx; border-radius: 18rpx; position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.product-tag { position: absolute; left: 10rpx; top: 10rpx; font-size: 17rpx; background: #FFF8ED; color: #88502D; padding: 6rpx 12rpx; border-radius: 10rpx; }
.product-pack { width: 120rpx; height: 158rpx; border-radius: 12rpx; background: #34765B; color: #fff; display: flex; align-items: center; justify-content: center; transform: rotate(-8deg); }
.pack-name { font-size: 29rpx; font-weight: 800; }
.tone-peach { background: #F7DFC6; }.tone-cocoa { background: #E9D3BE; }.tone-butter { background: #F5EDC6; }.tone-sage { background: #DDE9D8; }.tone-rose { background: #F3DFD5; }.tone-mango { background: #F8DFB5; }.tone-lemon { background: #EBEAC8; }.tone-oat { background: #E6E0D3; }
.product-name { margin: 16rpx 4rpx 5rpx; font-size: 25rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.product-spec { margin: 0 4rpx; font-size: 20rpx; color: #6C766B; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.product-price-row { display: flex; align-items: baseline; margin: 12rpx 4rpx 0; }
.product-price { font-size: 29rpx; font-weight: 800; color: #AF441F; }
.product-price text { font-size: 21rpx; }
.price-note { font-size: 17rpx; color: #949E94; margin-left: 8rpx; }
.qty-controls { display: flex; align-items: center; justify-content: flex-end; margin: 10rpx 4rpx 0; }
.qty-plus, .qty-minus { width: 56rpx; height: 66rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; background: #34765B; color: #fff; margin-left: 6rpx; }
.qty-minus { background: #EDF1E8; color: #34765B; }
.qty-value { font-size: 22rpx; min-width: 20rpx; text-align: center; }
.want-hint { min-height: 62rpx; display: flex; align-items: center; justify-content: center; margin: 12rpx 4rpx 0; background: #F5F7F1; color: #6C766B; font-size: 19rpx; border-radius: 16rpx; }
.want-hint.in-list { background: #EDF3E9; color: #34765B; font-weight: 700; }
.empty-results { padding: 56rpx 20rpx; color: #69746B; text-align: center; font-size: 24rpx; line-height: 1.6; }
.bottom-note { text-align: center; color: #919B92; font-size: 19rpx; margin-top: 40rpx; }
.floating-cart { position: fixed; left: 32rpx; right: 32rpx; bottom: calc(22rpx + env(safe-area-inset-bottom)); min-height: 100rpx; padding: 12rpx 16rpx 12rpx 26rpx; box-sizing: border-box; border-radius: 24rpx; display: flex; align-items: center; justify-content: space-between; background: #26352E; color: #fff; box-shadow: 0 10rpx 28rpx rgba(38,53,46,.16); }
.floating-count { font-size: 20rpx; color: #D4E0D6; }
.floating-price { font-size: 28rpx; font-weight: 700; }
.floating-button { background: #F6D781; color: #26352E; border-radius: 17rpx; padding: 20rpx; font-size: 23rpx; font-weight: 700; }
