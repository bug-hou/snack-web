@import "../../styles/snack.wxss";
.shop-page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: #F5F5F5; }
.shop-header { background: #F5F5F5; padding: 30rpx 30rpx 18rpx; flex-shrink: 0; }
.brand-line { display: flex; justify-content: space-between; align-items: center; }
.brand-kicker { font-size: 17rpx; color: #C81623; font-weight: 800; letter-spacing: 2rpx; }
.preview-pill { font-size: 18rpx; letter-spacing: 0; padding: 6rpx 12rpx; border-radius: 20rpx; background: #FFEFED; margin-left: 10rpx; }
.brand-name { font-size: 42rpx; line-height: 1.25; font-weight: 800; margin-top: 8rpx; letter-spacing: 1rpx; }
.brand-dot { color: #E1251B; }
.header-bag { position: relative; border: 1rpx solid #DEDEDE; background: white; border-radius: 30rpx; padding: 14rpx 20rpx; font-size: 22rpx; font-weight: 600; }
.bag-count { position: absolute; right: -9rpx; top: -14rpx; min-width: 30rpx; text-align: center; border-radius: 20rpx; background: #E1251B; color: white; font-size: 18rpx; padding: 0 5rpx; }
.delivery-hint { display: flex; align-items: center; margin-top: 18rpx; font-size: 21rpx; color: #878787; }
.hint-mark { width: 12rpx; height: 12rpx; border-radius: 50%; background: #A5A5A5; margin-right: 10rpx; }
.hint-separator { margin: 0 12rpx; color: #C8C8C8; }
.shop-scroll { flex: 1; min-height: 0; }
.shop-content { padding: 10rpx 30rpx 200rpx; }
.hero-card { position: relative; overflow: hidden; height: 326rpx; background: #FFEFED; border-radius: 30rpx; display: flex; box-shadow: 0 8rpx 22rpx rgba(101, 101, 101,0.06); }
.hero-copy { z-index: 1; padding: 36rpx 0 0 34rpx; }
.hero-kicker { font-size: 17rpx; letter-spacing: 2rpx; font-weight: 700; color: #707070; }
.hero-title { font-size: 40rpx; line-height: 1.22; color: #1A1A1A; font-weight: 800; margin-top: 20rpx; }
.hero-desc { font-size: 22rpx; margin-top: 12rpx; color: #787878; }
.hero-badge { font-size: 21rpx; font-weight: 700; color: #C81623; margin-top: 20rpx; }
.hero-art { position: absolute; width: 272rpx; height: 100%; right: 0; bottom: 0; }
.hero-sun { position: absolute; width: 232rpx; height: 232rpx; border-radius: 50%; background: #FFEFED; top: 28rpx; right: 8rpx; }
.hero-pack { position: absolute; bottom: -18rpx; right: 44rpx; height: 226rpx; width: 146rpx; background: #C81623; border-radius: 12rpx 12rpx 26rpx 26rpx; transform: rotate(13deg); color: #FFEFED; box-shadow: 22rpx 16rpx 0 #E1251B; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 27rpx; font-weight: 800; letter-spacing: 2rpx; }
.hero-pack-line { width: 90rpx; height: 2rpx; background: #FFEFED; margin-bottom: 20rpx; }.hero-pack-small { font-size: 12rpx; margin-top: 12rpx; letter-spacing: 1rpx; }
.benefit-row { display: flex; gap: 14rpx; margin-top: 18rpx; }.benefit { display: flex; align-items: center; flex: 1; min-width: 0; border-radius: 20rpx; padding: 17rpx 14rpx; background: #fff; gap: 10rpx; }.benefit-symbol { border-radius: 50%; background: #FFEFED; width: 36rpx; height: 36rpx; line-height: 36rpx; text-align: center; flex-shrink: 0; font-size: 17rpx; font-weight: 700; color: #C81623; }.benefit-title { font-size: 20rpx; font-weight: 700; }.benefit-desc { font-size: 17rpx; color: #929292; white-space: nowrap; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 44rpx 0 20rpx; }.section-eyebrow { color: #C81623; font-size: 17rpx; font-weight: 800; letter-spacing: 2rpx; }.section-name { font-size: 34rpx; font-weight: 800; margin-top: 6rpx; }.section-aside { font-size: 19rpx; color: #9C9C9C; padding-bottom: 6rpx; }.catalog-head { margin-top: 48rpx; }
.featured-image,.product-image{width:100%;height:100%;display:block;border-radius:inherit}.featured-scroll { width: 100%; white-space: nowrap; }.featured-item { display: inline-block; width: 210rpx; margin-right: 14rpx; vertical-align: top; }.featured-art { height: 154rpx; border-radius: 20rpx; display: flex; justify-content: center; align-items: center; overflow: hidden; }.mini-pack { height: 118rpx; width: 76rpx; border-radius: 6rpx 6rpx 12rpx 12rpx; background: #C81623; color: #fff; box-shadow: 8rpx 7rpx 0 rgba(81, 81, 81,0.18); transform: rotate(-9deg); text-align: center; display: flex; flex-direction: column; justify-content: center; font-size: 21rpx; font-weight: 700; }.mini-pack-bottom { font-size: 12rpx; margin-top: 12rpx; letter-spacing: 1rpx; }.featured-label { font-size: 22rpx; font-weight: 700; margin-top: 12rpx; }.featured-price { color: #C81623; font-size: 21rpx; font-weight: 700; }.featured-price text { color: #919191; font-size: 18rpx; margin-left: 5rpx; }
.search-box { background: #fff; border: 1rpx solid #EEEEEE; border-radius: 20rpx; height: 76rpx; padding: 0 22rpx; display: flex; align-items: center; gap: 16rpx; }.search-icon { width: 23rpx; height: 23rpx; border: 3rpx solid #A2A2A2; border-radius: 50%; position: relative; flex-shrink: 0; }.search-icon::after { content: ''; position: absolute; width: 12rpx; height: 3rpx; background: #A2A2A2; transform: rotate(45deg); right: -10rpx; bottom: -4rpx; }.search-input { flex: 1; font-size: 23rpx; }.search-placeholder { color: #AAAAAA; }.clear-search { font-size: 20rpx; color: #C81623; }
.category-scroll { white-space: nowrap; margin: 20rpx 0 24rpx; }.category-chip { display: inline-flex; padding: 13rpx 24rpx; background: #EEEEEE; border-radius: 30rpx; margin-right: 12rpx; font-size: 21rpx; color: #707070; }.category-chip.selected { background: #1A1A1A; color: white; }
.product-grid { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 18rpx 0; }.product-card { width: calc(50% - 9rpx); background: #fff; border-radius: 24rpx; padding: 12rpx 12rpx 17rpx; box-sizing: border-box; box-shadow: 0 4rpx 16rpx rgba(26, 26, 26,0.035); }.product-art { height: 228rpx; border-radius: 18rpx; position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; }.product-tag { position: absolute; left: 12rpx; top: 12rpx; background: #F5F5F5; border-radius: 24rpx; color: #C81623; padding: 5rpx 10rpx; font-size: 16rpx; font-weight: 700; }.product-pack { width: 122rpx; height: 160rpx; border-radius: 9rpx 9rpx 16rpx 16rpx; background: #E1251B; box-shadow: 12rpx 10rpx 0 rgba(26, 26, 26,0.16); transform: rotate(-8deg); display: flex; flex-direction: column; align-items: center; justify-content: space-between; padding: 22rpx 2rpx; box-sizing: border-box; color: #FFEFED; }.tone-cocoa .product-pack { background: #806153; }.tone-butter .product-pack { background: #D8A353; }.tone-sage .product-pack { background: #82967B; }.tone-rose .product-pack { background: #C6797B; }.tone-mango .product-pack { background: #D98B40; }.tone-lemon .product-pack { background: #A5AF67; }.tone-oat .product-pack { background: #A39275; }.pack-top, .pack-bottom { font-size: 12rpx; letter-spacing: 1rpx; }.pack-name { font-size: 29rpx; font-weight: 800; }.product-name { margin: 16rpx 4rpx 3rpx; font-size: 24rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.product-spec { margin: 0 4rpx; font-size: 18rpx; color: #9B9B9B; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.product-bottom { display: flex; justify-content: space-between; align-items: center; margin: 17rpx 4rpx 0; }.product-price { font-size: 28rpx; font-weight: 800; color: #C81623; }.product-price text { font-size: 20rpx; }.qty-controls { display: flex; align-items: center; gap: 6rpx; }.qty-plus, .qty-minus { width: 40rpx; height: 40rpx; border-radius: 50%; display: flex; justify-content: center; align-items: center; background: #1A1A1A; color: white; font-size: 25rpx; }.qty-minus { background: #EEEEEE; color: #1A1A1A; }.qty-value { font-size: 19rpx; min-width: 17rpx; text-align: center; }.empty-results { text-align: center; color: #8B8B8B; font-size: 23rpx; padding: 80rpx 0; }
.bottom-note { text-align: center; margin: 52rpx 0 10rpx; color: #A0A0A0; font-size: 19rpx; line-height: 1.7; }.floating-cart { position: fixed; bottom: calc(24rpx + env(safe-area-inset-bottom)); left: 30rpx; right: 30rpx; background: #E1251B; border-radius: 24rpx; min-height: 108rpx; padding: 12rpx 14rpx 12rpx 24rpx; display: flex; align-items: center; justify-content: space-between; color: white; box-shadow: 0 12rpx 30rpx rgba(225, 37, 27,0.23); }.floating-count { font-size: 22rpx; }.floating-price { font-size: 28rpx; font-weight: 800; }.floating-button { background: #FFFFFF; color: #E1251B; font-size: 21rpx; font-weight: 700; padding: 17rpx 16rpx; border-radius: 17rpx; }
.shop-page, .shop-header { background: #F5F5F5; }
.brand-kicker, .section-eyebrow { color: #E1251B; }
.delivery-hint { color: #E1251B; font-weight: 600; }
.hint-mark { background: #FF6A00; }
.hero-card { background: #FFEFED; }
.hero-sun { background: #FFEFED; }
.hero-title { color: #575757; }
.hero-pack { background: #E1251B; box-shadow: 22rpx 16rpx 0 #FF6A00; }
.benefit-symbol { background: #FFEFED; color: #E1251B; }
.category-chip { background: #FFEFED; color: #717171; }
.category-chip.selected { background: #E1251B; color: #fff; }
.qty-plus { background: #E1251B; }
.product-price, .featured-price { color: #E1251B; }
.buy-now { text-align: center; background: #FFEFED; color: #E1251B; border-radius: 14rpx; padding: 10rpx 0; font-size: 21rpx; font-weight: 700; margin: 12rpx 4rpx 0; }
.shop-state { background: #FFEFED; color: #E1251B; padding: 4rpx 10rpx; border-radius: 22rpx; margin-left: 8rpx; font-size: 17rpx; white-space: nowrap; }
.delivery-hint { flex-wrap: wrap; gap: 6rpx 0; }
.address-entry{display:flex;align-items:center;gap:18rpx;background:#fff;border-radius:22rpx;padding:16rpx 20rpx;margin-top:20rpx;box-shadow:0 5rpx 16rpx rgba(225, 37, 27,.07)}
.address-pin{border-radius:50%;width:55rpx;height:55rpx;display:flex;align-items:center;justify-content:center;background:#FFEFED;color:#E1251B;font-size:43rpx;flex-shrink:0}
.address-copy{min-width:0;flex:1}.address-caption{font-size:19rpx;color:#8F8F8F}.address-current{font-size:26rpx;color:#1A1A1A;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.address-current text{color:#E1251B}.address-sub{font-size:19rpx;color:#979797;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.address-entry .shop-state{padding:1rpx 8rpx;font-size:16rpx}.shop-header .delivery-hint{margin-top:12rpx}
