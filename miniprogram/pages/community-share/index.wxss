page { background: #F8F6F1; color: #26352E; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; }
button { padding: 0; margin: 0; font: inherit; line-height: normal; text-align: left; color: inherit; background: transparent; border: 0; border-radius: 0; overflow: visible; }
button::after { border: none; }
.share-page { padding: 24rpx 32rpx calc(160rpx + env(safe-area-inset-bottom)); }
.share-head { margin-bottom: 20rpx; }
.share-title { font-size: 40rpx; font-weight: 800; }
.share-sub { font-size: 23rpx; color: #66736C; margin-top: 8rpx; }
.scope-tabs { display: flex; background: #ECEFE6; padding: 7rpx; border-radius: 22rpx; margin-bottom: 24rpx; }
.scope-tab { flex: 1; text-align: center; min-height: 74rpx; line-height: 74rpx; font-size: 23rpx; color: #64705F; border-radius: 17rpx; }
.scope-tab.current { background: #fff; color: #26352E; font-weight: 700; }
.share-message { padding: 60rpx 0; text-align: center; color: #69746B; font-size: 24rpx; }
.share-empty { padding: 50rpx 30rpx; text-align: center; background: #fff; border: 1rpx solid #E4EAE0; border-radius: 26rpx; }
.empty-title { font-size: 28rpx; font-weight: 800; }
.empty-copy { font-size: 22rpx; color: #69746B; margin-top: 10rpx; line-height: 1.6; }
.item-card { display: flex; background: #fff; border: 1rpx solid #E4EAE0; border-radius: 26rpx; padding: 18rpx; margin-bottom: 18rpx; }
.item-art { width: 180rpx; height: 180rpx; flex-shrink: 0; border-radius: 20rpx; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #EDEFE6; color: #7C877D; font-size: 30rpx; font-weight: 800; }
.item-image { width: 100%; height: 100%; display: block; }
.item-body { flex: 1; min-width: 0; padding-left: 18rpx; overflow: hidden; }
.item-title { font-size: 26rpx; font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.item-tags { display: flex; flex-wrap: wrap; margin-top: 10rpx; }
.tag { display: inline-block; padding: 4rpx 12rpx; margin-right: 8rpx; border-radius: 10rpx; background: #EDF3E9; color: #34765B; font-size: 17rpx; }
.tag.mode { background: #FBE6D6; color: #8A5A33; }
.tag.mine { background: #ECEEE5; color: #5C685D; }
.item-desc { font-size: 21rpx; color: #6B756C; margin-top: 10rpx; line-height: 1.5; max-height: 66rpx; overflow: hidden; }
.item-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.item-price { font-size: 27rpx; font-weight: 800; color: #AF441F; }
.item-meetup { font-size: 19rpx; color: #8A938A; max-width: 240rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.publish-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; border-radius: 22rpx; background: #EDF3E9; color: #34765B; font-size: 25rpx; font-weight: 700; margin-top: 24rpx; }
.publish-button.floating { position: fixed; left: 32rpx; right: 32rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); margin-top: 0; background: #34765B; color: #fff; }
.tone-peach { background: #F7DFC6; }.tone-sage { background: #DDE9D8; }.tone-butter { background: #F5EDC6; }
