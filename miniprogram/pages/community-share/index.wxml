<view class="share-page">
  <view class="share-head">
    <view class="share-title">邻里闲置</view>
    <view class="share-sub">二手转让，也可以免费送给邻居</view>
  </view>

  <view class="scope-tabs">
    <view wx:for="{{tabs}}" wx:key="id" class="scope-tab {{scope === item.id ? 'current' : ''}}" data-scope="{{item.id}}" bindtap="selectTab">{{item.name}}</view>
  </view>

  <view wx:if="{{loading}}" class="share-message">正在加载物品…</view>
  <view wx:elif="{{error}}" class="share-message">{{error}}</view>
  <view wx:elif="{{!list.length}}" class="share-empty">
    <view class="empty-title">{{scope === 'mine' ? '还没有发布过物品' : '还没有邻居发布闲置'}}</view>
    <view class="empty-copy">{{scope === 'mine' ? '把家里用不上的好物拍张照，就能分享给邻居。' : '成为第一个分享的人吧，闲置也可以在小区里接力。'}}</view>
    <button wx:if="{{scope === 'mine'}}" class="publish-button" bindtap="goPublish">发布闲置　→</button>
  </view>
  <block wx:else>
    <view wx:for="{{list}}" wx:key="id" class="item-card" data-id="{{item.id}}" bindtap="openDetail">
      <view class="item-art tone-{{item.tone}}"><image wx:if="{{item.cover}}" class="item-image" src="{{item.cover}}" mode="aspectFill" lazy-load="{{true}}"/><text wx:else>{{item.initials}}</text></view>
      <view class="item-body">
        <view class="item-title">{{item.title}}</view>
        <view class="item-tags"><text class="tag mode">{{item.modeText}}</text><text class="tag">{{item.conditionText}}</text><text wx:if="{{item.isMine}}" class="tag mine">{{item.statusText}}</text></view>
        <view class="item-desc">{{item.description}}</view>
        <view class="item-foot"><text class="item-price">{{item.priceText}}</text><text class="item-meetup">{{item.meetup}}</text></view>
      </view>
    </view>
  </block>

  <button wx:if="{{list.length}}" class="publish-button floating" bindtap="goPublish">发布闲置　→</button>
</view>
