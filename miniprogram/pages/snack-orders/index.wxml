<view class="orders-wrap">
  <view class="orders-head">
    <view class="orders-title">我的订单</view>
    <view class="orders-sub">{{ownerView ? '店主工作台 · 可更新顾客订单进度' : '查看下单、配货与配送进度'}}</view>
  </view>

  <view wx:if="{{ownerWechat && !ownerView}}" class="wechat-tip" bindtap="copyWechat">
    <view class="wechat-tip-text">订单有疑问？添加店主微信 <text class="wechat-id">{{ownerWechat}}</text> 方便沟通</view>
    <view class="wechat-copy">复制</view>
  </view>
  <view wx:if="{{isOwner}}" class="owner-switch" bindtap="toggleView">{{ownerView ? '切回我的订单' : '切换到店主工作台'}}　→</view>

  <scroll-view scroll-x="{{true}}" class="order-tabs" show-scrollbar="{{false}}">
    <view wx:for="{{tabs}}" wx:key="id" class="order-tab {{activeTab === item.id ? 'current' : ''}}" data-tab="{{item.id}}" bindtap="selectTab"><text>{{item.name}}</text></view>
  </scroll-view>

  <view wx:if="{{loading}}" class="order-message">订单加载中…</view>
  <view wx:elif="{{error}}" class="order-message"><view>{{error}}</view><view class="retry" bindtap="loadOrders">点击重试</view></view>

  <block wx:elif="{{filteredOrders.length}}">
    <view wx:for="{{filteredOrders}}" wx:key="id" class="order-card">
      <view class="card-top">
        <view class="shop-line"><text class="shop-mark">铺</text><text class="shop-name">口袋便利铺</text><text class="shop-arrow">›</text></view>
        <view class="order-status status-{{item.status}}">{{item.statusText}}</view>
      </view>

      <view wx:if="{{item.progress >= 0}}" class="steps">
        <view wx:for="{{item.steps}}" wx:for-item="step" wx:key="*this" class="step {{item.progress > index ? 'done' : item.progress === index ? 'current' : ''}}"><text class="step-dot"></text><text class="step-text">{{step}}</text></view>
      </view>
      <view wx:else class="steps cancelled"><text class="step-text">{{item.stepText}}</text></view>

      <view class="card-body">
        <view class="thumbs">
          <view wx:for="{{item.thumbs}}" wx:for-item="thumb" wx:key="id" class="thumb tone-{{thumb.tone}}"><image wx:if="{{thumb.image}}" class="thumb-image" src="{{thumb.image}}" mode="aspectFill"/><text wx:else>{{thumb.initials}}</text></view>
          <view wx:if="{{item.moreCount > 0}}" class="thumb-more">+{{item.moreCount}}</view>
        </view>
        <view class="body-right">
          <view class="body-lines">{{item.linesText}}</view>
          <view class="body-time">{{item.deliveryText}}</view>
        </view>
      </view>

      <view class="card-foot">
        <view class="foot-sum"><text>共 {{item.count}} 件 · 合计</text><text class="foot-total">¥{{item.total}}</text></view>
        <view class="foot-actions">
          <view class="ghost-btn" data-id="{{item.id}}" bindtap="toggleDetail">{{expandedId === item.id ? '收起详情' : '订单详情'}}</view>
          <view wx:if="{{item.canCancel}}" class="ghost-btn" data-id="{{item.id}}" bindtap="cancel">取消订单</view>
          <view wx:if="{{item.canDelete}}" class="ghost-btn" data-id="{{item.id}}" bindtap="remove">删除订单</view>
          <view wx:if="{{ownerView && item.nextStatus}}" class="solid-btn" data-id="{{item.id}}" data-status="{{item.nextStatus}}" bindtap="advance">{{item.nextText}}</view>
        </view>
      </view>

      <view wx:if="{{expandedId === item.id}}" class="card-detail">
        <view class="detail-row"><text class="detail-label">订单编号</text><text class="detail-value break">{{item.id}}</text></view>
        <view class="detail-row"><text class="detail-label">收货信息</text><text class="detail-value">{{item.recipient}} · {{item.phone}}</text></view>
        <view class="detail-row"><text class="detail-label">送达地址</text><text class="detail-value">{{item.address}}</text></view>
        <view class="detail-row"><text class="detail-label">送达方式</text><text class="detail-value">{{item.contactText}} · {{item.delivery}}</text></view>
        <view wx:if="{{item.note}}" class="detail-row"><text class="detail-label">备注</text><text class="detail-value">{{item.note}}</text></view>
        <view class="detail-goods">
          <view wx:for="{{item.lines}}" wx:for-item="line" wx:key="id" class="goods-row"><text class="goods-name">{{line.name}} <text class="goods-spec">{{line.spec}}</text></text><text class="goods-qty">×{{line.quantity}}</text><text class="goods-price">¥{{line.subtotal}}</text></view>
        </view>
        <view class="detail-row sum"><text class="detail-label">商品小计</text><text class="detail-value">¥{{item.subtotal}}</text></view>
        <view class="detail-row sum"><text class="detail-label">上门配送费</text><text class="detail-value">¥{{item.deliveryFee}}</text></view>
        <view class="detail-row sum total"><text class="detail-label">订单合计 · 货到付款</text><text class="detail-value">¥{{item.total}}</text></view>
      </view>
    </view>
    <view class="order-bottom">已显示最近 {{filteredOrders.length}} 条订单 · 状态自动更新</view>
  </block>

  <view wx:else class="order-empty"><view class="empty-art"><view class="empty-pack">SOON</view></view><view class="empty-heading">还没有相关订单</view><view class="empty-copy">{{ownerView ? '收到新订单后，您可以在这里更新配货和配送进度。' : '选好所需商品，订单会在这里显示处理和配送进度。'}}</view><view class="primary-action empty-action" bindtap="goShop">去选购　→</view></view>
</view>
