@import "../../styles/snack.wxss";
.orders-wrap { min-height: 100vh; box-sizing: border-box; padding: 24rpx 32rpx calc(60rpx + env(safe-area-inset-bottom)); background: #F8F6F1; }
.orders-head { padding: 16rpx 4rpx 24rpx; }
.orders-title { font-size: 40rpx; font-weight: 800; }
.orders-sub { margin-top: 8rpx; font-size: 22rpx; color: #66736C; }

.wechat-tip { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; background: #FBE6D6; color: #8A5A33; border-radius: 18rpx; padding: 18rpx 22rpx; margin-bottom: 16rpx; font-size: 22rpx; line-height: 1.6; }
.wechat-tip-text { flex: 1; min-width: 0; }
.wechat-id { font-weight: 800; user-select: text; }
.wechat-copy { flex-shrink: 0; background: #34765B; color: #fff; border-radius: 999rpx; padding: 10rpx 24rpx; font-size: 21rpx; font-weight: 700; }
.owner-switch { background: #26352E; color: #fff; padding: 22rpx 24rpx; border-radius: 18rpx; font-weight: 700; font-size: 23rpx; margin-bottom: 16rpx; }

.order-tabs { white-space: nowrap; margin: 0 0 20rpx; }
.order-tab { display: inline-block; padding: 14rpx 28rpx; margin-right: 12rpx; border-radius: 30rpx; background: #ECEEE5; color: #5C685D; font-size: 23rpx; }
.order-tab.current { background: #34765B; color: #fff; font-weight: 700; }

.order-message { text-align: center; color: #69746B; font-size: 24rpx; padding: 70rpx 0; }
.retry { display: inline-block; margin-top: 20rpx; color: #34765B; font-weight: 700; }
.order-empty { margin-top: 80rpx; text-align: center; }
.order-bottom { text-align: center; font-size: 20rpx; color: #8A938A; padding: 30rpx 0 10rpx; }

.order-card { background: #fff; border: 1rpx solid #E4EAE0; border-radius: 26rpx; padding: 26rpx 24rpx 22rpx; margin-bottom: 20rpx; }
.card-top { display: flex; align-items: center; justify-content: space-between; }
.shop-line { display: flex; align-items: center; gap: 12rpx; }
.shop-mark { width: 44rpx; height: 44rpx; border-radius: 14rpx; background: #EDF3E9; color: #34765B; font-size: 22rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.shop-name { font-size: 27rpx; font-weight: 800; }
.shop-arrow { color: #9AA49A; font-size: 28rpx; }
.order-status { font-size: 23rpx; font-weight: 700; color: #34765B; }
.status-completed { color: #8A938A; }
.status-cancelled { color: #8A938A; }
.status-delivering { color: #ED6A38; }

.steps { display: flex; margin: 22rpx 0 4rpx; padding: 20rpx 0 6rpx; border-top: 1rpx solid #EEF1EA; }
.steps.cancelled { justify-content: flex-start; color: #8A938A; font-size: 23rpx; }
.step { flex: 1; position: relative; display: flex; flex-direction: column; align-items: center; }
.step::before { content: ''; position: absolute; top: 9rpx; left: -50%; right: 50%; height: 4rpx; background: #E6EAE0; }
.step:first-child::before { display: none; }
.step.done::before, .step.current::before { background: #34765B; }
.step-dot { position: relative; z-index: 1; width: 18rpx; height: 18rpx; border-radius: 50%; background: #E6EAE0; box-sizing: border-box; border: 4rpx solid #fff; box-shadow: 0 0 0 2rpx #E6EAE0; }
.step.done .step-dot { background: #34765B; box-shadow: 0 0 0 2rpx #34765B; }
.step.current .step-dot { background: #fff; box-shadow: 0 0 0 4rpx #34765B; }
.step-text { margin-top: 10rpx; font-size: 19rpx; color: #8A938A; }
.step.done .step-text { color: #5C685D; }
.step.current .step-text { color: #34765B; font-weight: 700; }

.card-body { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 0 6rpx; }
.thumbs { display: flex; gap: 10rpx; flex-shrink: 0; }
.thumb { width: 104rpx; height: 104rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; font-size: 24rpx; font-weight: 700; color: #6B4A2B; }
.thumb-image { width: 100%; height: 100%; display: block; }
.thumb-more { width: 56rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; color: #8A938A; font-size: 22rpx; }
.body-right { flex: 1; min-width: 0; }
.body-lines { font-size: 25rpx; color: #26352E; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.body-time { margin-top: 8rpx; font-size: 21rpx; color: #8A938A; line-height: 1.5; }

.card-foot { margin-top: 14rpx; padding-top: 18rpx; border-top: 1rpx solid #EEF1EA; }
.foot-sum { display: flex; justify-content: flex-end; align-items: baseline; gap: 10rpx; font-size: 22rpx; color: #6B756C; }
.foot-total { font-size: 32rpx; font-weight: 800; color: #AF441F; }
.foot-actions { display: flex; justify-content: flex-end; gap: 14rpx; margin-top: 18rpx; }
.ghost-btn, .solid-btn { padding: 12rpx 28rpx; border-radius: 999rpx; font-size: 23rpx; border: 1rpx solid #DDE3D8; color: #4C5B50; }
.solid-btn { border-color: #34765B; background: #34765B; color: #fff; font-weight: 700; }

.card-detail { margin-top: 18rpx; padding-top: 10rpx; border-top: 1rpx dashed #E4EAE0; }
.detail-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 10rpx 0; font-size: 22rpx; line-height: 1.6; }
.detail-label { color: #8A938A; flex-shrink: 0; }
.detail-value { color: #26352E; text-align: right; min-width: 0; }
.detail-value.break { word-break: break-all; font-size: 20rpx; }
.detail-goods { margin: 8rpx 0; padding: 8rpx 0; border-top: 1rpx solid #EEF1EA; border-bottom: 1rpx solid #EEF1EA; }
.goods-row { display: flex; align-items: baseline; gap: 14rpx; padding: 8rpx 0; font-size: 23rpx; }
.goods-name { flex: 1; min-width: 0; color: #26352E; }
.goods-spec { color: #8A938A; font-size: 19rpx; margin-left: 6rpx; }
.goods-qty { color: #6B756C; }
.goods-price { min-width: 100rpx; text-align: right; color: #26352E; }
.detail-row.sum .detail-value { color: #4C5B50; }
.detail-row.total .detail-label { color: #26352E; font-weight: 700; }
.detail-row.total .detail-value { color: #AF441F; font-weight: 800; font-size: 26rpx; }
.body-quote { margin-top: 8rpx; font-size: 21rpx; color: #8A5A33; background: #FBE6D6; border-radius: 12rpx; padding: 10rpx 14rpx; }
