@import "../../styles/snack.wxss";
.orders-wrap { min-height: 100vh; box-sizing: border-box; padding: 0 24rpx 160rpx; background: #F5F5F5; }
.orders-head { padding: 40rpx 6rpx 24rpx; }
.orders-title { font-size: 44rpx; font-weight: 800; letter-spacing: -1rpx; }
.orders-sub { margin-top: 8rpx; font-size: 23rpx; color: #8B8B8B; }

.wechat-tip { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; background: #FFF6E5; color: #B54708; border-radius: 16rpx; padding: 18rpx 22rpx; margin-bottom: 16rpx; font-size: 22rpx; line-height: 1.6; }
.wechat-tip-text { flex: 1; min-width: 0; }
.wechat-id { font-weight: 800; user-select: text; }
.wechat-copy { flex-shrink: 0; background: #E1251B; color: #fff; border-radius: 999rpx; padding: 8rpx 22rpx; font-size: 21rpx; }
.owner-switch { background: #1A1A1A; color: #fff; padding: 22rpx 24rpx; border-radius: 16rpx; font-weight: 700; font-size: 23rpx; margin-bottom: 16rpx; }

.order-tabs { white-space: nowrap; margin: 0 -24rpx 18rpx; padding: 0 12rpx; background: #fff; box-sizing: border-box; border-bottom: 1rpx solid #EFEFEF; }
.order-tab { display: inline-block; padding: 24rpx 26rpx 20rpx; font-size: 26rpx; color: #777; position: relative; }
.order-tab.current { color: #1A1A1A; font-weight: 800; font-size: 28rpx; }
.order-tab.current::after { content: ''; position: absolute; left: 50%; bottom: 6rpx; width: 36rpx; height: 6rpx; margin-left: -18rpx; border-radius: 6rpx; background: #E1251B; }

.order-message { text-align: center; color: #878787; font-size: 24rpx; padding: 90rpx 0; }
.retry { display: inline-block; margin-top: 20rpx; color: #E1251B; }
.order-empty { margin-top: 110rpx; text-align: center; }
.order-bottom { text-align: center; font-size: 20rpx; color: #B0B0B0; padding: 30rpx 0 10rpx; }

.order-card { background: #fff; border-radius: 20rpx; padding: 26rpx 26rpx 22rpx; margin-bottom: 20rpx; }
.card-top { display: flex; align-items: center; justify-content: space-between; }
.shop-line { display: flex; align-items: center; gap: 12rpx; }
.shop-mark { width: 38rpx; height: 38rpx; border-radius: 10rpx; background: #E1251B; color: #fff; font-size: 21rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.shop-name { font-size: 28rpx; font-weight: 800; }
.shop-arrow { color: #B5B5B5; font-size: 28rpx; }
.order-status { font-size: 24rpx; font-weight: 700; color: #E1251B; }
.status-completed { color: #8A8A8A; }
.status-cancelled { color: #A0A0A0; }
.status-delivering { color: #12A150; }

.steps { display: flex; margin: 24rpx 0 4rpx; padding: 18rpx 0 6rpx; border-top: 1rpx solid #F3F3F3; }
.steps.cancelled { justify-content: flex-start; color: #A0A0A0; font-size: 23rpx; }
.step { flex: 1; position: relative; display: flex; flex-direction: column; align-items: center; }
.step::before { content: ''; position: absolute; top: 9rpx; left: -50%; right: 50%; height: 4rpx; background: #E6E6E6; }
.step:first-child::before { display: none; }
.step.done::before, .step.current::before { background: #E1251B; }
.step-dot { position: relative; z-index: 1; width: 18rpx; height: 18rpx; border-radius: 50%; background: #E6E6E6; box-sizing: border-box; border: 4rpx solid #fff; box-shadow: 0 0 0 2rpx #E6E6E6; }
.step.done .step-dot { background: #E1251B; box-shadow: 0 0 0 2rpx #E1251B; }
.step.current .step-dot { background: #fff; box-shadow: 0 0 0 4rpx #E1251B; border-color: #E1251B; }
.step-text { margin-top: 10rpx; font-size: 19rpx; color: #A5A5A5; }
.step.done .step-text { color: #777; }
.step.current .step-text { color: #E1251B; font-weight: 700; }

.card-body { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 0 6rpx; }
.thumbs { display: flex; gap: 10rpx; flex-shrink: 0; }
.thumb { width: 104rpx; height: 104rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; font-size: 24rpx; font-weight: 700; color: #6B4A2B; }
.thumb-image { width: 100%; height: 100%; display: block; }
.thumb-more { width: 56rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; color: #999; font-size: 22rpx; }
.body-right { flex: 1; min-width: 0; }
.body-lines { font-size: 25rpx; color: #333; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.body-time { margin-top: 8rpx; font-size: 21rpx; color: #9A9A9A; line-height: 1.5; }

.card-foot { margin-top: 14rpx; padding-top: 18rpx; border-top: 1rpx solid #F3F3F3; }
.foot-sum { display: flex; justify-content: flex-end; align-items: baseline; gap: 10rpx; font-size: 22rpx; color: #666; }
.foot-total { font-size: 32rpx; font-weight: 800; color: #1A1A1A; }
.foot-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 18rpx; }
.ghost-btn, .solid-btn { padding: 12rpx 28rpx; border-radius: 999rpx; font-size: 23rpx; border: 1rpx solid #D9D9D9; color: #444; }
.solid-btn { border-color: #E1251B; background: #E1251B; color: #fff; font-weight: 700; }

.card-detail { margin-top: 18rpx; padding-top: 10rpx; border-top: 1rpx dashed #E4E4E4; }
.detail-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 10rpx 0; font-size: 22rpx; line-height: 1.6; }
.detail-label { color: #999; flex-shrink: 0; }
.detail-value { color: #333; text-align: right; min-width: 0; }
.detail-value.break { word-break: break-all; font-size: 20rpx; }
.detail-goods { margin: 8rpx 0; padding: 8rpx 0; border-top: 1rpx solid #F3F3F3; border-bottom: 1rpx solid #F3F3F3; }
.goods-row { display: flex; align-items: baseline; gap: 14rpx; padding: 8rpx 0; font-size: 23rpx; }
.goods-name { flex: 1; min-width: 0; color: #333; }
.goods-spec { color: #A5A5A5; font-size: 19rpx; margin-left: 6rpx; }
.goods-qty { color: #888; }
.goods-price { min-width: 100rpx; text-align: right; color: #333; }
.detail-row.sum .detail-value { color: #555; }
.detail-row.total .detail-label { color: #1A1A1A; font-weight: 700; }
.detail-row.total .detail-value { color: #E1251B; font-weight: 800; font-size: 26rpx; }
