@import "../../styles/snack.wxss";
.order-tabs { white-space: nowrap; background: #fff; border-radius: 18rpx; padding: 18rpx 16rpx; margin-bottom: 22rpx; box-sizing: border-box; }.order-tab { display: inline-flex; align-items: center; padding: 6rpx 20rpx; color: #9A958D; font-size: 22rpx; }.order-tab.current { color: #B45139; font-weight: 800; }.owner-switch { background: #324137; color: white; padding: 24rpx; border-radius: 20rpx; font-weight: 700; font-size: 23rpx; margin-bottom: 18rpx; }.order-empty { margin-top: 110rpx; text-align: center; }.order-message { text-align: center; color: #8E8880; font-size: 24rpx; padding: 90rpx 0; }.retry { display: inline-block; margin-top: 20rpx; color: #B5513B; }.order-card { background: white; border-radius: 22rpx; padding: 24rpx; margin: 18rpx 0; }.order-card-head { display: flex; align-items: flex-start; justify-content: space-between; border-bottom: 1rpx solid #F2EEE8; padding-bottom: 18rpx; gap: 10rpx; }.order-no { font-size: 18rpx; color: #726C64; max-width: 390rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.order-date { font-size: 19rpx; color: #ABA59B; margin-top: 6rpx; }.order-status { white-space: nowrap; color: #9C5A3F; background: #F7EDE3; padding: 6rpx 14rpx; border-radius: 20rpx; font-size: 21rpx; }.status-completed { color: #53745C; background: #E9F2E8; }.status-cancelled { color: #999; background: #F1F1F1; }.order-line { display: flex; justify-content: space-between; font-size: 24rpx; padding: 12rpx 0; }.order-info { border-top: 1rpx solid #F2EEE8; color: #847D73; font-size: 21rpx; line-height: 1.7; padding: 15rpx 0; word-break: break-all; }.order-card-foot { display: flex; justify-content: space-between; align-items: center; padding-top: 16rpx; border-top: 1rpx solid #F2EEE8; }.pay-method { color: #8F867A; font-size: 20rpx; }.order-total { color: #B55039; font-size: 26rpx; font-weight: 700; }.order-action, .order-cancel { border-radius: 18rpx; background: #303A31; color: #fff; padding: 15rpx 18rpx; font-size: 22rpx; }.order-cancel { background: #F2EEE9; color: #87584A; }.order-bottom { text-align: center; font-size: 19rpx; color: #AAA29A; padding: 36rpx; }
.order-tab.current, .order-total { color: #F25B4C; }
.owner-switch, .order-action { background: #FF654E; }
.order-status { color: #E95649; background: #FFF0E4; }
.order-progress { display: flex; justify-content: space-between; gap: 4rpx; padding: 20rpx 0; border-bottom: 1rpx solid #F2EEE8; }
.progress-point { flex: 1; text-align: center; font-size: 18rpx; color: #AAA3A0; border-radius: 20rpx; background: #F7F4F1; padding: 7rpx 0; }
.progress-point.active { color: #E95448; background: #FFE8D8; font-weight: 700; }
