@import "../../styles/snack.wxss";
.order-tabs { white-space: nowrap; background: #fff; border-radius: 18rpx; padding: 18rpx 16rpx; margin-bottom: 22rpx; box-sizing: border-box; }.order-tab { display: inline-flex; align-items: center; padding: 6rpx 20rpx; color: #939393; font-size: 22rpx; }.order-tab.current { color: #C81623; font-weight: 800; }.owner-switch { background: #1A1A1A; color: white; padding: 24rpx; border-radius: 20rpx; font-weight: 700; font-size: 23rpx; margin-bottom: 18rpx; }.order-empty { margin-top: 110rpx; text-align: center; }.order-message { text-align: center; color: #878787; font-size: 24rpx; padding: 90rpx 0; }.retry { display: inline-block; margin-top: 20rpx; color: #C81623; }.order-card { background: white; border-radius: 22rpx; padding: 24rpx; margin: 18rpx 0; }.order-card-head { display: flex; align-items: flex-start; justify-content: space-between; border-bottom: 1rpx solid #EEEEEE; padding-bottom: 18rpx; gap: 10rpx; }.order-no { font-size: 18rpx; color: #6B6B6B; max-width: 390rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.order-date { font-size: 19rpx; color: #A3A3A3; margin-top: 6rpx; }.order-status { white-space: nowrap; color: #C81623; background: #FFEFED; padding: 6rpx 14rpx; border-radius: 20rpx; font-size: 21rpx; }.status-completed { color: #646464; background: #E9F2E8; }.status-cancelled { color: #999; background: #EEEEEE; }.order-line { display: flex; justify-content: space-between; font-size: 24rpx; padding: 12rpx 0; }.order-info { border-top: 1rpx solid #EEEEEE; color: #7C7C7C; font-size: 21rpx; line-height: 1.7; padding: 15rpx 0; word-break: break-all; }.order-card-foot { display: flex; justify-content: space-between; align-items: center; padding-top: 16rpx; border-top: 1rpx solid #EEEEEE; }.pay-method { color: #858585; font-size: 20rpx; }.order-total { color: #C81623; font-size: 26rpx; font-weight: 700; }.order-action, .order-cancel { border-radius: 18rpx; background: #1A1A1A; color: #fff; padding: 15rpx 18rpx; font-size: 22rpx; }.order-cancel { background: #EEEEEE; color: #696969; }.order-bottom { text-align: center; font-size: 19rpx; color: #A2A2A2; padding: 36rpx; }
.order-tab.current, .order-total { color: #E1251B; }
.owner-switch, .order-action { background: #E1251B; }
.order-status { color: #E1251B; background: #FFEFED; }
.order-progress { display: flex; justify-content: space-between; gap: 4rpx; padding: 20rpx 0; border-bottom: 1rpx solid #EEEEEE; }
.progress-point { flex: 1; text-align: center; font-size: 18rpx; color: #A5A5A5; border-radius: 20rpx; background: #EEEEEE; padding: 7rpx 0; }
.progress-point.active { color: #E1251B; background: #FFEFED; font-weight: 700; }
