<view class="snack-page">
  <view class="page-lead"><view class="small-kicker">MY LIST / 需求清单</view><view class="page-title">日常所需都在这<text class="title-period">.</text></view><view class="page-sub">挑好想买的，登记后由店家与您线下确认，线下当面结算</view></view>
  <view class="compliance-banner">清单只记录您想要的商品与数量，不构成订单。提交后会生成一条需求登记，由店家线下与您联系确认。</view>
  <view wx:if="{{loading}}" class="cart-loading"><view class="cart-spinner"></view><view>正在加载清单…</view></view>
  <block wx:elif="{{count}}">
    <view class="cart-card">
      <view class="cart-header"><text>已选 {{count}} 件</text><text class="clear-link" bindtap="clearCart">清空清单</text></view>
      <view wx:for="{{items}}" wx:key="id" class="cart-item"><view class="cart-art tone-{{item.tone}}"><image wx:if="{{item.image}}" class="cart-image" src="{{item.image}}" mode="aspectFill"/><view wx:else class="cart-pack">{{item.initials}}</view></view><view class="cart-info"><view class="cart-name">{{item.name}}</view><view class="cart-spec">{{item.spec}}</view><view class="cart-price">¥{{item.price}}</view></view><view class="cart-controls"><view class="cart-btn" data-id="{{item.id}}" bindtap="reduce">－</view><text>{{item.quantity}}</text><view class="cart-btn plus" data-id="{{item.id}}" bindtap="add">＋</view></view></view>
    </view>
    <view class="cart-summary"><view class="summary-row"><text>商品参考金额</text><text>¥{{total}}</text></view><view class="summary-row"><text>预计跑腿配送费</text><text>¥{{deliveryFee}}</text></view><view class="summary-divider"></view><view class="summary-row emphasis"><text>参考合计</text><text>¥{{payable}}</text></view></view>
    <view wx:if="{{belowMinimum}}" class="notice-card">商品满 ¥{{minOrder}} 起送，再挑点喜欢的吧。</view>
    <view wx:if="{{catalogError}}" class="notice-card">{{catalogError}}</view>
    <view class="cart-footer"><view class="cart-footer-price"><text>参考合计</text><view>¥{{payable}}</view></view><view class="primary-action" bindtap="goCheckout">{{belowMinimum ? '继续挑选' : '登记需求　→'}}</view></view>
  </block>
  <view wx:else class="empty-cart"><view class="empty-art"><view class="empty-pack">DAILY</view></view><view class="empty-heading">清单还空空的</view><view class="empty-copy">家里缺什么？鸡蛋、牛奶、纸巾都可以先记下来</view><view class="primary-action empty-action" bindtap="goShop">去挑商品　→</view></view>
</view>
