@import "../../styles/snack.wxss";
.compliance-banner { margin-bottom: 20rpx; padding: 16rpx 20rpx; border-radius: 18rpx; background: #F1EFE5; color: #6C766B; font-size: 19rpx; line-height: 1.6; }
.cart-card, .cart-summary { background: #fff; border: 1rpx solid #E4EAE0; border-radius: 26rpx; padding: 6rpx 26rpx; margin-bottom: 20rpx; }
.cart-header { display: flex; justify-content: space-between; align-items: center; padding: 26rpx 0; font-size: 27rpx; font-weight: 800; border-bottom: 1rpx solid #EEF1EA; }
.clear-link { font-size: 22rpx; color: #8A938A; font-weight: 400; }
.cart-item { padding: 24rpx 0; display: flex; align-items: center; gap: 20rpx; border-bottom: 1rpx solid #EEF1EA; }
.cart-item:last-child { border-bottom: 0; }
.cart-art { width: 132rpx; height: 132rpx; flex-shrink: 0; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.cart-image { width: 100%; height: 100%; display: block; }
.cart-pack { height: 80rpx; width: 60rpx; border-radius: 8rpx; background: #34765B; color: #fff; transform: rotate(-8deg); display: flex; justify-content: center; align-items: center; font-size: 17rpx; font-weight: 700; }
.cart-info { flex: 1; min-width: 0; }
.cart-name { font-size: 25rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cart-spec { font-size: 19rpx; color: #8A938A; margin: 6rpx 0; }
.cart-price { font-size: 26rpx; color: #AF441F; font-weight: 800; }
.cart-controls { display: flex; gap: 10rpx; align-items: center; font-size: 22rpx; flex-shrink: 0; }
.cart-btn { width: 44rpx; height: 44rpx; border-radius: 50%; background: #ECEEE5; display: flex; align-items: center; justify-content: center; color: #4C5B50; font-size: 24rpx; }
.cart-btn.plus { background: #34765B; color: #fff; }
.cart-summary { padding: 14rpx 26rpx; }
.summary-row { display: flex; justify-content: space-between; color: #6B756C; font-size: 23rpx; padding: 16rpx 0; }
.summary-divider { height: 1rpx; background: #EEF1EA; }
.summary-row.emphasis { font-size: 26rpx; font-weight: 800; color: #26352E; }
.summary-row.emphasis text:last-child { color: #AF441F; }
.notice-card { border-radius: 18rpx; padding: 20rpx 22rpx; background: #FBE6D6; color: #8A5A33; font-size: 22rpx; line-height: 1.6; margin-bottom: 16rpx; }
.cart-footer { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-top: 1rpx solid #E4EAE0; padding: 18rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.cart-footer-price { font-size: 20rpx; color: #6B756C; }
.cart-footer-price view { font-size: 32rpx; color: #AF441F; font-weight: 800; }
.cart-footer .primary-action { min-width: 300rpx; font-size: 24rpx; }
.empty-cart { text-align: center; margin-top: 120rpx; }
.cart-loading { display: flex; flex-direction: column; align-items: center; gap: 22rpx; margin-top: 150rpx; color: #8A938A; font-size: 24rpx; }
.cart-spinner { width: 56rpx; height: 56rpx; border-radius: 50%; border: 6rpx solid #DCE6D4; border-top-color: #34765B; animation: cart-spin .8s linear infinite; }
@keyframes cart-spin { to { transform: rotate(360deg); } }
