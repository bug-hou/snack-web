@import "../../styles/snack.wxss";
.cart-card, .cart-summary { background: #fff; border-radius: 26rpx; padding: 10rpx 26rpx; margin-bottom: 20rpx; }.cart-header { display: flex; justify-content: space-between; padding: 25rpx 0; font-size: 27rpx; font-weight: 700; border-bottom: 1rpx solid #F0EBE4; }.clear-link { font-size: 22rpx; color: #9B968F; font-weight: 400; }.cart-item { padding: 23rpx 0; display: flex; align-items: center; gap: 20rpx; border-bottom: 1rpx solid #F2EDE7; }.cart-item:last-child { border: 0; }.cart-art { width: 132rpx; height: 132rpx; flex-shrink: 0; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; }.cart-pack { height: 80rpx; width: 60rpx; border-radius: 6rpx 6rpx 12rpx 12rpx; background: #AD664C; color: white; box-shadow: 7rpx 6rpx 0 rgba(80,64,48,0.14); transform: rotate(-8deg); display: flex; justify-content: center; align-items: center; font-size: 17rpx; font-weight: 700; }.cart-info { flex: 1; min-width: 0; }.cart-name { font-size: 24rpx; font-weight: 700; }.cart-spec { font-size: 19rpx; color: #A29C92; margin: 6rpx 0; }.cart-price { font-size: 24rpx; color: #B44F3A; font-weight: 700; }.cart-controls { display: flex; gap: 10rpx; align-items: center; font-size: 22rpx; }.cart-btn { width: 39rpx; height: 39rpx; border-radius: 50%; background: #F3F0EC; display: flex; align-items: center; justify-content: center; color: #333; font-size: 25rpx; }.cart-btn.plus { background: #30372F; color: #fff; }.cart-summary { padding: 14rpx 26rpx; }.summary-row { display: flex; justify-content: space-between; color: #817C75; font-size: 23rpx; padding: 14rpx 0; }.summary-divider { height: 1rpx; background: #F2EDE7; }.summary-row.emphasis { font-size: 26rpx; font-weight: 700; color: #292821; }.summary-row.emphasis text:last-child { color: #B44F3A; }.notice-card { border-radius: 20rpx; padding: 22rpx 24rpx; background: #F6EEE3; color: #947354; font-size: 21rpx; line-height: 1.6; }.cart-footer { position: fixed; left: 0; right: 0; bottom: 0; background: white; border-top: 1rpx solid #F0ECE7; padding: 18rpx 30rpx calc(20rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }.cart-footer-price { font-size: 19rpx; color: #938E87; }.cart-footer-price view { font-size: 32rpx; color: #B54D38; font-weight: 800; }.cart-footer .primary-action { min-width: 300rpx; font-size: 23rpx; }.empty-cart { text-align: center; margin-top: 130rpx; }
.cart-image{width:100%;height:100%;border-radius:18rpx;display:block}.cart-btn.plus { background: #FF7451; }
.cart-price, .summary-row.emphasis text:last-child, .cart-footer-price view { color: #F25B4C; }
.notice-card { background: #FFF1D7; color: #98612E; }
