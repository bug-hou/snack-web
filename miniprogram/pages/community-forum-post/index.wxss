page { background: #F8F6F1; color: #26352E; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; }
button { padding: 0; margin: 0; font: inherit; line-height: normal; text-align: left; color: inherit; background: transparent; border: 0; border-radius: 0; overflow: visible; }
button::after { border: none; }

.form-page { padding: 28rpx 32rpx calc(60rpx + env(safe-area-inset-bottom)); }
.form-head { margin-bottom: 26rpx; }
.form-title { font-size: 40rpx; font-weight: 800; }
.form-sub { font-size: 22rpx; color: #66736C; margin-top: 8rpx; }

.form-card { background: #fff; border: 1rpx solid #E4EAE0; border-radius: 26rpx; padding: 24rpx; margin-bottom: 20rpx; }
.form-label { font-size: 25rpx; font-weight: 800; }
.label-note { font-size: 19rpx; font-weight: 400; color: #949E94; margin-left: 8rpx; }
.field-hint { font-size: 19rpx; color: #8A5A33; margin-top: 12rpx; line-height: 1.55; }

.board-grid { display: flex; flex-wrap: wrap; margin-top: 18rpx; }
.board-option { padding: 12rpx 26rpx; margin: 0 14rpx 14rpx 0; border-radius: 30rpx; background: #ECEFE6; color: #5C685D; font-size: 22rpx; }
.board-option.selected { background: #34765B; color: #fff; font-weight: 700; }

.title-input { width: 100%; min-height: 82rpx; margin-top: 16rpx; padding: 0 20rpx; background: #F5F7F1; border-radius: 18rpx; font-size: 26rpx; }
.content-input { width: 100%; height: 320rpx; margin-top: 16rpx; padding: 20rpx; background: #F5F7F1; border-radius: 18rpx; font-size: 25rpx; line-height: 1.65; }
.counter { text-align: right; font-size: 18rpx; color: #949E94; margin-top: 10rpx; }

.image-row { display: flex; flex-wrap: wrap; margin-top: 18rpx; }
.image-box { position: relative; width: 178rpx; height: 178rpx; margin: 0 14rpx 14rpx 0; }
.image-preview { width: 100%; height: 100%; border-radius: 18rpx; display: block; }
.image-remove { position: absolute; right: -8rpx; top: -8rpx; width: 44rpx; height: 44rpx; border-radius: 50%; background: #26352E; color: #fff; font-size: 26rpx; display: flex; align-items: center; justify-content: center; }
.image-add { width: 178rpx; height: 178rpx; border-radius: 18rpx; border: 2rpx dashed #C7D0C4; color: #8A958B; font-size: 44rpx; display: flex; align-items: center; justify-content: center; }

.rules-card { padding: 24rpx; border-radius: 26rpx; background: #F1EFE5; }
.rules-title { font-size: 23rpx; font-weight: 800; margin-bottom: 12rpx; }
.rule-line { font-size: 19rpx; color: #6C766B; line-height: 1.75; }

.form-error { margin-top: 20rpx; padding: 18rpx 22rpx; border-radius: 18rpx; background: #FBEAE3; color: #A2461F; font-size: 21rpx; }

.form-footer { margin-top: 32rpx; }
.submit-button { min-height: 92rpx; border-radius: 24rpx; background: #34765B; color: #fff; font-size: 27rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.submit-button.disabled { background: #A9B4A9; }
.cancel-button { min-height: 88rpx; margin-top: 16rpx; border-radius: 24rpx; background: #ECEFE6; color: #5C685D; font-size: 25rpx; display: flex; align-items: center; justify-content: center; }
