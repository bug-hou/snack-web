# 服务端口
PORT=3000

# MongoDB 连接（本机默认）
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=aishangli

# JWT 密钥：生产环境必须改成随机长字符串
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=please-change-this-to-a-random-string
JWT_EXPIRES_IN=30d

# 上传目录与单文件大小上限（MB）
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# 允许的前端来源，多个用逗号分隔；开发期可用 * ，生产务必写具体域名
CORS_ORIGIN=*

# 站长账号：注册时命中这些用户名会自动获得管理员权限，多个用逗号分隔
ADMIN_USERNAMES=admin

# 内容安全（可选）：不配置时使用内置敏感词库
# TMS_ENABLED=true 后需填写腾讯云 API 密钥，走文本内容安全 TextModeration
TMS_ENABLED=false
TMS_SECRET_ID=
TMS_SECRET_KEY=
TMS_REGION=ap-guangzhou

# 图片存储
# COS_ENABLED=false → 存本地 uploads/ 目录（本地开发，无需密钥）
# COS_ENABLED=true  → 存腾讯云 COS，需配置桶与密钥
COS_ENABLED=false
COS_BUCKET=
COS_REGION=
# 桶内统一前缀，留空表示各目录平铺在桶根下
COS_PREFIX=
# false = 公有读永久直链；true = 私有桶签名临时链接（有时效，需前端定期刷新）
COS_PRIVATE=false
COS_SIGN_EXPIRES=7200
COS_SECRET_ID=
COS_SECRET_KEY=
